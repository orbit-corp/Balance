<% content_for :title, "Review" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Review" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "Review",
    description: "Bank transfers detected in forwarded WhatsApp receipts. Confirm to add them to your books." %>

<% if @extractions.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/check-circle.svg",
      title: "Nothing to review",
      description: "Detected transfers will show up here for you to confirm." %>
<% else %>
  <div class="mt-4 flex flex-col gap-4">
    <% @extractions.each do |extraction| %>
      <% message = extraction.whatsapp_message %>

      <div class="rounded-md border border-neutral-200 bg-white p-4">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <% if extraction.bank_transfer? && extraction.currency_supported? && extraction.amount_kobo.present? %>
                <span class="text-lg font-semibold tabular-nums text-neutral-900"><%= naira(extraction.amount_kobo) %></span>
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-700">
                  <%= extraction.direction_outward? ? "Money out" : (extraction.direction_inward? ? "Money in" : "Transfer") %>
                </span>
              <% else %>
                <span class="text-sm font-medium text-amber-700">Possibly financial — review manually</span>
                <% if extraction.currency.present? && !extraction.currency_supported? %>
                  <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700"><%= extraction.currency %> — not supported</span>
                <% end %>
              <% end %>
            </div>

            <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
              <% {
                   "From" => extraction.sender_name,
                   "To" => extraction.recipient_name,
                   "Bank" => extraction.recipient_bank,
                   "Reference" => extraction.reference_number,
                   "Date" => extraction.transaction_date&.strftime("%b %-d, %Y")
                 }.each do |label, value| %>
                <% next if value.blank? %>
                <div class="flex gap-2">
                  <dt class="flex-none text-neutral-500"><%= label %></dt>
                  <dd class="min-w-0 truncate text-neutral-900"><%= value %></dd>
                </div>
              <% end %>
            </dl>

            <p class="mt-2 text-xs text-neutral-500">
              Forwarded <%= message.sent_at&.strftime("%b %-d, %-l:%M %p") %>
              <span class="px-0.5 text-neutral-300">·</span>
              <%= link_to "view message", messages_path, class: "font-medium text-neutral-700 hover:underline" %>
            </p>
          </div>

          <% if message.media.attached? && message.media_image? %>
            <%= image_tag message.media, class: "h-20 w-20 flex-none rounded-md object-cover" %>
          <% elsif message.media.attached? %>
            <%= link_to "File", url_for(message.media), class: "flex h-20 w-20 flex-none items-center justify-center rounded-md border border-neutral-200 text-xs text-neutral-600" %>
          <% end %>
        </div>

        <div class="mt-3 flex items-center gap-2 border-t border-neutral-200 pt-3">
          <%= link_to "Record entry", new_journal_entry_path, class: primary_button_class(size: :sm) %>
          <%= button_to "Dismiss", dismiss_document_review_path(extraction), method: :patch,
                class: secondary_button_class(size: :sm),
                form: { data: { turbo_confirm: "Dismiss this document?" } } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
