<% content_for :title, "Review" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-neutral-900">Review</h1>
    <p class="text-sm text-(--color-muted-foreground)">Bank transfers detected in forwarded WhatsApp receipts. Confirm to add them to your books.</p>
  </div>

  <% if @extractions.empty? %>
    <div class="rounded-xl border border-dashed border-(--color-border) bg-white p-8 text-center">
      <p class="text-sm text-(--color-muted-foreground)">Nothing to review. Detected transfers will show up here for you to confirm.</p>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @extractions.each do |extraction| %>
        <% message = extraction.whatsapp_message %>
        <div class="rounded-xl border border-(--color-border) bg-white p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <% if extraction.bank_transfer? && extraction.currency_supported? && extraction.amount_kobo.present? %>
                  <span class="text-lg font-semibold text-neutral-900"><%= format_naira(extraction.amount_kobo) %></span>
                  <span class="rounded-full bg-(--color-accent) px-2 py-0.5 text-xs font-medium text-neutral-700"><%= extraction.direction_outward? ? "Money out" : (extraction.direction_inward? ? "Money in" : "Transfer") %></span>
                <% else %>
                  <span class="text-sm font-medium text-amber-700">Possibly financial — review manually</span>
                  <% if extraction.currency.present? && !extraction.currency_supported? %>
                    <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700"><%= extraction.currency %> — not supported</span>
                  <% end %>
                <% end %>
              </div>

              <dl class="mt-2 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                <% {
                     "From" => extraction.sender_name,
                     "To" => extraction.recipient_name,
                     "Bank" => extraction.recipient_bank,
                     "Reference" => extraction.reference_number,
                     "Date" => extraction.transaction_date&.strftime("%b %-d, %Y")
                   }.each do |label, value| %>
                  <% next if value.blank? %>
                  <div class="flex gap-2">
                    <dt class="text-(--color-muted-foreground)"><%= label %>:</dt>
                    <dd class="min-w-0 truncate text-neutral-900"><%= value %></dd>
                  </div>
                <% end %>
              </dl>

              <p class="mt-2 text-xs text-(--color-muted-foreground)">
                Forwarded <%= message.sent_at&.strftime("%b %-d, %-l:%M %p") %> ·
                <%= link_to "view message", messages_path, class: "underline" %>
              </p>
            </div>

            <% if message.media.attached? && message.media_image? %>
              <%= image_tag message.media, class: "h-20 w-20 flex-none rounded-md object-cover" %>
            <% elsif message.media.attached? %>
              <%= link_to "File", url_for(message.media), class: "flex h-20 w-20 flex-none items-center justify-center rounded-md border border-(--color-border) text-xs text-neutral-600" %>
            <% end %>
          </div>

          <div class="mt-3 flex items-center gap-2 border-t border-(--color-border) pt-3">
            <% if extraction.bank_transfer? && extraction.currency_supported? && extraction.amount_kobo.present? %>
              <%= link_to "Record entry",
                    new_transaction_path(
                      kind: extraction.kind_guess,
                      amount: extraction.amount&.to_s("F"),
                      occurred_on: extraction.transaction_date,
                      description: review_description(extraction),
                      whatsapp_document_extraction_id: extraction.id
                    ),
                    class: "inline-flex items-center rounded-md bg-neutral-900 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-neutral-800" %>
            <% else %>
              <%= link_to "Add manually",
                    new_transaction_path(kind: "expense"),
                    class: "inline-flex items-center rounded-md border border-(--color-border) bg-white px-3 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-(--color-accent)" %>
            <% end %>

            <%= button_to "Dismiss", dismiss_document_review_path(extraction), method: :patch,
                  class: "inline-flex items-center rounded-md border border-(--color-border) bg-white px-3 py-1.5 text-sm font-medium text-neutral-600 transition hover:bg-(--color-accent)",
                  form: { data: { turbo_confirm: "Dismiss this document?" } } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
