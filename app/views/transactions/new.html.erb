<%= turbo_frame_tag "transaction_form" do %>
  <div class="rounded-lg border border-(--color-border) bg-white p-4">
    <h2 class="mb-4 text-lg font-semibold text-neutral-900">
      <%= @transaction.kind == "expense" ? "Add expense" : "Add sale" %>
    </h2>

    <%= render "form", transaction: @transaction %>
  </div>
<% end %>
