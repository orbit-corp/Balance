<%# Server-side pagination. Page links carry the active filter so paging never silently
    drops it. %>
<% window = ((pagy.page - 2)..(pagy.page + 2)).select { |page| page.between?(1, pagy.pages) } %>
<% link_classes = "inline-flex min-w-8 items-center justify-center rounded-md border border-(--color-border) bg-white px-2 py-1.5 text-sm font-medium text-neutral-700 transition hover:bg-(--color-accent)" %>
<% muted_classes = "inline-flex min-w-8 items-center justify-center rounded-md border border-(--color-border) px-2 py-1.5 text-sm text-neutral-300" %>

<div class="flex flex-col gap-3 border-t border-(--color-border) px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
  <span class="text-sm text-(--color-muted-foreground) tabular-nums">
    <% if pagy.count.zero? %>
      No entries
    <% else %>
      Showing <%= pagy.from %>–<%= pagy.to %> of <%= pagy.count %>
    <% end %>
  </span>

  <% if pagy.pages > 1 %>
    <nav class="-mx-4 flex items-center gap-1 overflow-x-auto px-4 sm:mx-0 sm:px-0" aria-label="Pagination">
      <% if pagy.previous %>
        <%= link_to "Previous", transactions_path(filter: filter, page: pagy.previous), class: link_classes %>
      <% else %>
        <span class="<%= muted_classes %>">Previous</span>
      <% end %>

      <% if window.first > 1 %>
        <%= link_to 1, transactions_path(filter: filter, page: 1), class: link_classes %>
        <span class="px-1 text-sm text-(--color-muted-foreground)">…</span>
      <% end %>

      <% window.each do |page| %>
        <% if page == pagy.page %>
          <span aria-current="page" class="inline-flex min-w-8 items-center justify-center rounded-md bg-neutral-900 px-2 py-1.5 text-sm font-medium text-white tabular-nums"><%= page %></span>
        <% else %>
          <%= link_to page, transactions_path(filter: filter, page: page), class: "#{link_classes} tabular-nums" %>
        <% end %>
      <% end %>

      <% if window.last < pagy.pages %>
        <span class="px-1 text-sm text-(--color-muted-foreground)">…</span>
        <%= link_to pagy.pages, transactions_path(filter: filter, page: pagy.pages), class: link_classes %>
      <% end %>

      <% if pagy.next %>
        <%= link_to "Next", transactions_path(filter: filter, page: pagy.next), class: link_classes %>
      <% else %>
        <span class="<%= muted_classes %>">Next</span>
      <% end %>
    </nav>
  <% end %>
</div>
