<% content_for :title, "Transactions" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-neutral-900">All entries</h1>
    <p class="text-sm text-(--color-muted-foreground)">Every sale and expense in your books</p>
  </div>

  <div id="balance_tiles">
    <%= render "accounts/balance_tiles", summary: @summary %>
  </div>

  <div id="ledger_entries">
    <%= render "transactions/entries", transactions: @transactions, pagy: @pagy, counts: @counts, filter: @filter %>
  </div>
</div>
