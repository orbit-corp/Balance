<%# Shared by create, update, destroy and post_to_books. Every region the ledger can
    move is refreshed; Turbo ignores the ids that aren't on the current page, so this
    works from the dashboard and the entries list alike. %>
<%= turbo_stream.update "modal", "" %>

<%= turbo_stream.update "period_cards" do %>
  <%= render "dashboards/period_cards", summary: @summary %>
<% end %>

<%= turbo_stream.update "recent_feed" do %>
  <%= render "dashboards/recent_feed", summary: @summary %>
<% end %>

<%= turbo_stream.update "balance_tiles" do %>
  <%= render "accounts/balance_tiles", summary: @summary %>
<% end %>

<%= turbo_stream.update "ledger_entries" do %>
  <%= render "transactions/entries", transactions: @transactions, pagy: @pagy, counts: @counts, filter: @filter %>
<% end %>
