<tr id="<%= dom_id(transaction) %>" data-datatable-target="row" data-kind="<%= transaction.kind %>" class="border-b border-(--color-border) transition last:border-0 hover:bg-(--color-accent)/50">
  <td class="w-8 px-0 pl-4">
    <input type="checkbox" data-datatable-target="rowCheck" data-action="datatable#rowToggle" class="ui-checkbox" aria-label="Select row">
  </td>
  <td class="px-4 py-3 max-w-0">
    <div class="truncate text-sm font-semibold text-neutral-900"><%= transaction.description.presence || "—" %></div>
    <div class="truncate text-xs text-(--color-muted-foreground)"><%= transaction.category %></div>
  </td>
  <td class="px-4 py-3 text-sm text-(--color-muted-foreground) whitespace-nowrap"><%= transaction_party_text(transaction) %></td>
  <td class="px-4 py-3 text-sm font-semibold tabular-nums whitespace-nowrap <%= transaction.income? ? "text-green-700" : "text-red-600" %>">
    <%= transaction.income? ? "+" : "−" %><%= format_naira(transaction.amount_kobo) %>
  </td>
  <td class="px-4 py-3 whitespace-nowrap">
    <span class="inline-flex items-center gap-1.5 text-sm text-neutral-900">
      <span class="h-[7px] w-[7px] rounded-full <%= transaction.income? ? "bg-green-600" : "bg-red-500" %>" aria-hidden="true"></span>
      <%= transaction.income? ? "Sale" : "Expense" %>
    </span>
  </td>
  <td class="px-4 py-3 text-sm text-(--color-muted-foreground) tabular-nums whitespace-nowrap"><%= transaction.occurred_on.strftime("%b %-d, %Y") %></td>
  <td class="w-10 px-2 py-3 text-right">
    <div data-controller="menu" class="relative inline-block text-left">
      <button type="button" data-menu-target="button" data-action="menu#toggle" class="rounded-md p-1.5 text-neutral-500 transition hover:bg-(--color-accent) hover:text-neutral-900" aria-label="Row actions">
        <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
      </button>
      <div data-menu-target="menu" class="hidden w-36 rounded-md border border-(--color-border) bg-white py-1 shadow-md">
        <%= link_to "Edit", edit_transaction_path(transaction), data: { turbo_frame: "transaction_form" }, class: "block px-3 py-1.5 text-sm text-neutral-700 transition hover:bg-(--color-accent)" %>
        <div class="my-1 h-px bg-(--color-border)"></div>
        <%= button_to "Delete", transaction_path(transaction), method: :delete, class: "block w-full bg-transparent px-3 py-1.5 text-left text-sm text-red-600 transition hover:bg-red-50", form: { data: { turbo_confirm: "Delete this entry?" } } %>
      </div>
    </div>
  </td>
</tr>
