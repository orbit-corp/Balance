<%# `pagy`, `counts` and `filter` are only supplied by the entries page; the dashboard feed
    renders the same table without them. %>
<% if transactions.empty? && local_assigns[:counts].to_h.values.sum.zero? %>
  <div class="rounded-xl border border-dashed border-(--color-border) bg-white p-8 text-center">
    <p class="text-sm text-(--color-muted-foreground)">No entries yet.</p>
    <%= link_to "Log your first sale", new_transaction_path(kind: "income"), data: { turbo_frame: "modal" }, class: "mt-2 inline-block text-sm font-medium text-neutral-900 underline" %>
  </div>
<% else %>
  <%= render "transactions/table",
             transactions: transactions,
             pagy: local_assigns[:pagy],
             counts: local_assigns[:counts],
             filter: local_assigns[:filter] %>
<% end %>
