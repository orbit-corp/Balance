<div id="<%= dom_id(transaction) %>_mobile" data-datatable-target="row" data-kind="<%= transaction.kind %>" class="space-y-1.5 px-4 py-3">
  <div class="flex items-start justify-between gap-3">
    <span class="truncate text-sm font-semibold text-neutral-900"><%= transaction.description.presence || "—" %></span>
    <span class="shrink-0 text-sm font-semibold tabular-nums <%= transaction.income? ? "text-green-700" : "text-red-600" %>">
      <%= transaction.income? ? "+" : "−" %><%= format_naira(transaction.amount_kobo) %>
    </span>
  </div>

  <div class="flex items-center justify-between gap-3 text-xs text-(--color-muted-foreground)">
    <span class="inline-flex items-center gap-1.5">
      <span class="h-[7px] w-[7px] rounded-full <%= transaction.income? ? "bg-green-600" : "bg-red-500" %>" aria-hidden="true"></span>
      <%= transaction.income? ? "Sale" : "Expense" %> · <%= transaction.category %>
    </span>
    <span class="tabular-nums"><%= transaction.occurred_on.strftime("%b %-d, %Y") %></span>
  </div>

  <% if (party = transaction_party_text(transaction)) != "—" %>
    <div class="text-xs text-(--color-muted-foreground)"><%= party %></div>
  <% end %>
</div>
