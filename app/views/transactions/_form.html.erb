<% field_classes = "w-full rounded-md border border-(--color-border) bg-white px-3 py-2 text-sm shadow-sm transition focus:border-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900/10" %>
<% label_classes = "mb-1.5 block text-sm font-medium text-neutral-700" %>

<%= form_with model: transaction, class: "space-y-4", data: { controller: "transaction-form" } do |form| %>
  <% if params[:whatsapp_document_extraction_id].present? %>
    <%= hidden_field_tag :whatsapp_document_extraction_id, params[:whatsapp_document_extraction_id] %>
  <% end %>

  <% if transaction.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc pl-4">
        <% transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="<%= label_classes %>">Type</label>
    <div class="grid grid-cols-2 gap-2">
      <% %w[income expense].each do |kind| %>
        <label class="flex cursor-pointer items-center justify-center rounded-md border border-(--color-border) px-4 py-2 text-sm font-medium transition has-[:checked]:border-neutral-900 has-[:checked]:bg-neutral-900 has-[:checked]:text-white">
          <%= form.radio_button :kind, kind, checked: transaction.kind == kind, class: "sr-only", data: { transaction_form_target: "kindInput", action: "change->transaction-form#toggleKind" } %>
          <%= kind == "income" ? "Sale" : "Expense" %>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.label :amount, "Amount (₦)", class: label_classes %>
    <%= form.text_field :amount, value: transaction.amount, inputmode: "decimal", required: true, placeholder: "0.00", class: field_classes %>
  </div>

  <div>
    <%= form.label :category, "Category", class: label_classes %>
    <%= form.select :category,
          grouped_options_for_select(
            { "Sales" => ApplicationHelper::TRANSACTION_CATEGORIES["income"],
              "Expense" => ApplicationHelper::TRANSACTION_CATEGORIES["expense"] },
            transaction.category
          ),
          {},
          class: field_classes,
          data: { transaction_form_target: "categorySelect" } %>
  </div>

  <div data-transaction-form-target="customerField" class="<%= "hidden" if transaction.kind == "expense" %>">
    <%= form.label :customer_id, "Customer (optional)", class: label_classes %>
    <%= form.select :customer_id,
          options_from_collection_for_select(current_workspace.customers.order(:name), :id, :name, transaction.customer_id),
          { include_blank: "No customer" },
          class: field_classes %>
    <p class="mt-1.5 text-xs text-(--color-muted-foreground)">
      Need a new customer? <%= link_to "Add one", new_customer_path, class: "underline" %> first.
    </p>
  </div>

  <div>
    <%= form.label :occurred_on, "Date", class: label_classes %>
    <%= form.date_field :occurred_on, value: transaction.occurred_on || Date.current, required: true, class: field_classes %>
  </div>

  <div>
    <%= form.label :description, "Description (optional)", class: label_classes %>
    <%= form.text_area :description, rows: 2, class: field_classes %>
  </div>

  <%= form.submit transaction.persisted? ? "Save changes" : "Add entry", class: "w-full cursor-pointer rounded-md bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800" %>
<% end %>
