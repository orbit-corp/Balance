<% nav_link = ->(path, label, active, icon) do
     classes = "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium transition " \
               "#{active ? "bg-(--color-accent) text-neutral-900" : "text-neutral-600 hover:bg-(--color-accent) hover:text-neutral-900"}"
     link_to(path, class: classes) { inline_svg_tag(icon, class: "h-4 w-4 flex-none") + content_tag(:span, label) }
   end %>

<div class="flex h-full flex-col p-3">
  <div class="flex items-center gap-2 px-2 py-2">
    <span class="text-base font-semibold text-neutral-900">Stubby</span>
  </div>

  <div class="mt-3 flex items-center gap-2">
    <%= link_to new_journal_entry_path, class: "flex flex-1 items-center justify-center gap-2 rounded-md bg-neutral-900 px-3 py-2 text-sm font-medium text-white transition hover:bg-neutral-800" do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>
      New entry
    <% end %>
  </div>

  <% review_count = current_workspace.whatsapp_document_extractions.awaiting_review.count %>
  <nav class="mt-4 flex flex-col gap-1">
    <%#= nav_link.call(dashboard_path, "Dashboard", current_page?(dashboard_path) || current_page?(root_path), "icons/home.svg") %>
    <%= nav_link.call(journal_entries_path, "Journal entries", current_page?(journal_entries_path), "icons/list.svg") %>
    <%= nav_link.call(accounts_path, "Accounts", current_page?(accounts_path), "icons/wallet.svg") %>
    <%#= nav_link.call(messages_path, "Messages", current_page?(messages_path), "icons/message-circle.svg") %>
    <!-- <%= link_to document_reviews_path, class: "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium transition #{current_page?(document_reviews_path) ? "bg-(--color-accent) text-neutral-900" : "text-neutral-600 hover:bg-(--color-accent) hover:text-neutral-900"}" do %>
      <%= inline_svg_tag "icons/check-circle.svg", class: "h-4 w-4 flex-none" %>
      <span class="flex-1">Review</span>
      <% if review_count.positive? %>
        <span class="inline-flex min-w-5 items-center justify-center rounded-full bg-neutral-900 px-1.5 text-xs font-semibold text-white"><%= review_count %></span>
      <% end %>
    <% end %> -->
    <%#= nav_link.call(campaigns_path, "Campaigns", current_page?(campaigns_path), "icons/megaphone.svg") %>
  </nav>

  <div class="mt-5">
    <p class="px-3 pb-1 text-xs font-medium text-(--color-muted-foreground)">Records</p>
    <nav class="flex flex-col gap-1">
      <%= nav_link.call(customers_path, "Customers", current_page?(customers_path), "icons/users.svg") %>
    </nav>
  </div>

  <div class="mt-5">
    <p class="px-3 pb-1 text-xs font-medium text-(--color-muted-foreground)">Workspace</p>
    <nav class="flex flex-col gap-1">
      <%= nav_link.call(integrations_path, "Integrations", current_page?(integrations_path), "icons/puzzle.svg") %>
    </nav>
  </div>

  <div class="mt-auto border-t border-(--color-border) pt-3">
    <div data-controller="menu" class="relative">
      <button type="button" data-menu-target="button" data-action="menu#toggle" class="flex w-full items-center gap-2.5 rounded-md px-2 py-2 text-left transition hover:bg-(--color-accent)">
        <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-neutral-200 text-xs font-semibold text-neutral-700"><%= current_workspace.name.first&.upcase %></span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-medium text-neutral-900"><%= current_workspace.name %></p>
          <p class="truncate text-xs text-(--color-muted-foreground)"><%= Current.user.email_address %></p>
        </div>
        <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4 flex-none text-neutral-500" %>
      </button>

      <div data-menu-target="menu" class="hidden w-56 rounded-lg border border-(--color-border) bg-white p-1 shadow-md">
        <div class="flex items-center gap-2.5 px-2 py-1.5">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-neutral-200 text-xs font-semibold text-neutral-700"><%= current_workspace.name.first&.upcase %></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-neutral-900"><%= current_workspace.name %></p>
            <p class="truncate text-xs text-(--color-muted-foreground)"><%= Current.user.email_address %></p>
          </div>
        </div>

        <div class="my-1 h-px bg-(--color-border)"></div>

        <%= link_to customers_path, class: "flex items-center gap-2.5 rounded-md px-2 py-2 text-sm text-neutral-700 transition hover:bg-(--color-accent)" do %>
          <%= inline_svg_tag "icons/users.svg", class: "h-4 w-4 flex-none" %>
          Customers
        <% end %>
        <%= link_to journal_entries_path, class: "flex items-center gap-2.5 rounded-md px-2 py-2 text-sm text-neutral-700 transition hover:bg-(--color-accent)" do %>
          <%= inline_svg_tag "icons/list.svg", class: "h-4 w-4 flex-none" %>
          Journal entries
        <% end %>

        <div class="my-1 h-px bg-(--color-border)"></div>

        <%= button_to session_path, method: :delete, class: "flex w-full items-center gap-2.5 rounded-md bg-transparent px-2 py-2 text-left text-sm text-red-600 transition hover:bg-red-50", form: { data: { turbo_confirm: "Sign out of Stubby?" } } do %>
          <%= inline_svg_tag "icons/log-out.svg", class: "h-4 w-4 flex-none" %>
          Log out
        <% end %>
      </div>
    </div>
  </div>
</div>
