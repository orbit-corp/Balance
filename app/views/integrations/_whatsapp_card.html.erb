<div id="whatsapp_integration_card" class="rounded-md border border-neutral-200 bg-white p-5">
  <div class="flex items-start gap-3">
    <span class="flex h-10 w-10 flex-none items-center justify-center rounded-md bg-green-50 text-green-700">
      <%= inline_svg_tag "icons/whatsapp.svg", class: "h-5 w-5" %>
    </span>

    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-neutral-900">WhatsApp capture</p>
      <p class="mt-0.5 text-sm text-neutral-500">Forward a receipt or transfer screenshot to your Stubby number and we'll draft the transaction for you.</p>
    </div>
  </div>

  <div class="mt-4 border-t border-neutral-200 pt-4">
    <% if link&.active? %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-neutral-900">
            <%= link.profile_name.presence || "WhatsApp" %>
            <span class="font-normal text-neutral-500">(<%= link.masked_wa_id %>)</span>
          </p>
          <p class="mt-0.5 text-xs text-green-700">Connected</p>
        </div>

        <%= button_to "Disconnect", disconnect_integrations_whatsapp_path, method: :delete, class: secondary_button_class %>
      </div>

    <% elsif token.present? %>
      <p class="text-sm text-neutral-900">Sending you to WhatsApp — just hit send there to connect.</p>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <span class="rounded-md border border-neutral-200 bg-neutral-50 px-3 py-1.5 font-mono text-sm tracking-wide text-neutral-900"><%= token.token %></span>

        <%= link_to "Open WhatsApp again", "https://wa.me/#{ENV['WHATSAPP_BUSINESS_NUMBER']}?text=#{token.token}",
              target: "_blank", rel: "noopener", class: secondary_button_class %>
      </div>

      <p class="mt-3 text-xs text-neutral-500">Waiting for your message… code expires <%= time_ago_in_words(token.expires_at) %> from now.</p>

    <% else %>
      <button type="button"
              data-controller="whatsapp-connect"
              data-whatsapp-connect-url-value="<%= connect_integrations_whatsapp_path(format: :json) %>"
              data-action="whatsapp-connect#open"
              class="<%= primary_button_class %>">
        <%= inline_svg_tag "icons/whatsapp.svg", class: "h-4 w-4" %>Connect
      </button>
    <% end %>
  </div>
</div>
