<%
link ||= local_assigns[:link]
token ||= local_assigns[:token]
%>

<div id="whatsapp_integration_card" class="rounded-xl border border-(--color-border) bg-white p-4">
  <div class="flex items-start justify-between gap-3">
    <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-green-50 text-green-700">
      <%= inline_svg_tag "icons/whatsapp.svg", class: "h-5 w-5" %>
    </span>
    <button type="button" class="flex h-8 w-8 flex-none items-center justify-center rounded-md text-(--color-muted-foreground) transition hover:bg-(--color-accent)">
      <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
    </button>
  </div>

  <div class="mt-3">
    <p class="text-sm font-medium text-neutral-900">WhatsApp capture</p>
    <p class="mt-0.5 text-sm text-(--color-muted-foreground)">Forward a receipt or transfer screenshot to your Stubby number and we'll draft the transaction for you.</p>
  </div>

  <div class="mt-4 border-t border-(--color-border) pt-4">
    <% if link&.active? %>
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-sm font-medium text-neutral-900"><%= link.profile_name.presence || "WhatsApp" %> <span class="text-(--color-muted-foreground)">(<%= link.masked_wa_id %>)</span></p>
          <p class="mt-0.5 text-xs text-green-700">Connected</p>
        </div>
        <%= button_to "Disconnect", disconnect_integrations_whatsapp_path, method: :delete,
              class: "rounded-md border border-(--color-border) px-3.5 py-2 text-sm font-medium text-neutral-700 transition hover:bg-(--color-accent)" %>
      </div>
    <% elsif token.present? %>
      <p class="text-sm text-neutral-900">Sending you to WhatsApp — just hit send there to connect.</p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <span class="rounded-md border border-(--color-border) bg-(--color-accent)/60 px-3 py-1.5 font-mono text-sm tracking-wide text-neutral-900"><%= token.token %></span>
        <%= link_to "Open WhatsApp again", "https://wa.me/#{ENV['WHATSAPP_BUSINESS_NUMBER']}?text=#{token.token}",
              target: "_blank", rel: "noopener",
              class: "flex items-center gap-2 rounded-md border border-(--color-border) px-3.5 py-2 text-sm font-medium text-neutral-700 transition hover:bg-(--color-accent)" %>
      </div>
      <p class="mt-3 text-xs text-(--color-muted-foreground)">Waiting for your message… code expires <%= time_ago_in_words(token.expires_at) %> from now.</p>
    <% else %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button type="button" class="flex items-center gap-2 text-sm text-(--color-muted-foreground) transition hover:text-neutral-900">
          <%= inline_svg_tag "icons/settings.svg", class: "h-4 w-4" %>
          Details
        </button>
        <button type="button"
                data-controller="whatsapp-connect"
                data-whatsapp-connect-url-value="<%= connect_integrations_whatsapp_path(format: :json) %>"
                data-action="whatsapp-connect#open"
                class="flex items-center gap-2 rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-neutral-800">
          <%= inline_svg_tag "icons/whatsapp.svg", class: "h-4 w-4" %>
          Connect
        </button>
      </div>
    <% end %>
  </div>
</div>
