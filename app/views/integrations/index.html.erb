<% content_for :title, "Integrations" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Integrations" } ] %>
<% end %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_integrations" %>

<%= render "shared/page_header",
    title: "Integrations",
    description: "Connect the tools your business already runs on." %>

<div class="mt-4 grid gap-4 sm:grid-cols-2">
  <%= render "integrations/whatsapp_card", link: @whatsapp_link, token: @whatsapp_token %>
</div>
