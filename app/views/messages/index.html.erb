<% content_for :title, "Messages" %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_messages" %>

<div class="space-y-4">
  <div>
    <h1 class="text-xl font-semibold text-neutral-900">Messages</h1>
    <p class="text-sm text-(--color-muted-foreground)">Receipts and messages forwarded over WhatsApp.</p>
  </div>

  <div id="messages_thread" class="flex flex-col gap-3 rounded-lg border border-(--color-border) bg-white p-4">
    <% if @messages.empty? %>
      <p class="py-8 text-center text-sm text-(--color-muted-foreground)">No messages yet. Forwarded receipts and messages will show up here.</p>
    <% else %>
      <% last_day = nil %>
      <% @messages.each do |message| %>
        <% day = message.sent_at&.to_date %>
        <% if day != last_day %>
          <div class="my-2 flex items-center gap-2 text-xs font-medium text-(--color-muted-foreground)">
            <div class="h-px flex-1 bg-(--color-border)"></div>
            <span><%= day ? day.strftime("%B %-d, %Y") : "Unknown date" %></span>
            <div class="h-px flex-1 bg-(--color-border)"></div>
          </div>
          <% last_day = day %>
        <% end %>
        <%= render partial: "messages/message", locals: { message: message } %>
      <% end %>
    <% end %>
  </div>
</div>
