<% content_for :title, "Messages" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Messages" } ] %>
<% end %>

<%= turbo_stream_from "workspace_#{current_workspace.id}_messages" %>

<%= render "shared/page_header",
    title: "Messages",
    description: "Receipts and messages forwarded over WhatsApp." %>

<div id="messages_thread" data-controller="messages-thread"
     class="mt-4 flex h-[calc(100vh-16rem)] flex-col gap-3 overflow-y-auto rounded-md border border-neutral-200 bg-white p-4">
  <% if @messages.empty? && @page == 1 %>
    <p class="py-8 text-center text-sm text-neutral-500">No messages yet. Forwarded receipts and messages will show up here.</p>
  <% else %>
    <%= render "messages/older_trigger", page: @page, has_more: @has_more %>

    <div id="messages_list" class="contents">
      <%= render "messages/message_batch", messages: @messages %>
    </div>
  <% end %>
</div>
