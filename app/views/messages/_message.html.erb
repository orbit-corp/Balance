<div id="<%= dom_id(message) %>" class="flex flex-col items-start gap-1"
     data-day="<%= message.sent_at&.to_date&.iso8601 %>"
     data-day-label="<%= message.sent_at ? message.sent_at.to_date.strftime("%B %-d, %Y") : "Unknown date" %>">
  <div class="max-w-[85%] rounded-lg rounded-tl-sm bg-(--color-accent) px-3 py-2 text-sm text-neutral-900 sm:max-w-[60%]">
    <% if message.message_type == "text" %>
      <p class="whitespace-pre-wrap break-words"><%= message.body %></p>
    <% elsif message.media_image? %>
      <% if message.media.attached? %>
        <%= image_tag message.media, class: "rounded-lg max-w-[240px]" %>
      <% elsif message.media_status == "failed" %>
        <p class="text-red-600 italic">Couldn't download this image</p>
      <% else %>
        <p class="text-(--color-muted-foreground) italic">Downloading image…</p>
      <% end %>
    <% elsif %w[document audio video sticker].include?(message.message_type) %>
      <% if message.media.attached? %>
        <%= link_to message.media.filename, url_for(message.media), class: "inline-flex items-center gap-2 rounded-md border border-(--color-border) bg-white px-2 py-1 text-sm text-neutral-900 hover:bg-(--color-accent)" %>
      <% elsif message.media_status == "failed" %>
        <p class="text-red-600 italic">Couldn't download this attachment</p>
      <% else %>
        <p class="text-(--color-muted-foreground) italic">Downloading attachment…</p>
      <% end %>
    <% else %>
      <p class="text-(--color-muted-foreground) italic">[<%= message.message_type %>]</p>
    <% end %>
  </div>

  <% if message.classified? && (extraction = message.document_extraction).present? %>
    <% if extraction.bank_transfer? && extraction.currency_supported? && extraction.amount_kobo.present? %>
      <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
        💰 <%= format_naira(extraction.amount_kobo) %><%= " · #{extraction.transaction_date.strftime("%b %-d")}" if extraction.transaction_date %>
      </span>
    <% elsif extraction.bank_transfer? || extraction.needs_review? %>
      <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">Possibly financial — review</span>
    <% end %>
  <% end %>

  <p class="px-1 text-xs text-(--color-muted-foreground)"><%= message.sent_at&.strftime("%b %-d, %-l:%M %p") %></p>
</div>
