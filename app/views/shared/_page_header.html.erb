<div class="flex flex-col gap-y-3 sm:flex-row sm:items-center sm:justify-between sm:gap-x-4">
  <div class="flex flex-col gap-y-1">
    <h1 class="text-base font-medium text-neutral-900"><%= title %></h1>

    <% if local_assigns[:description] %>
      <p class="text-sm text-neutral-500"><%= description %></p>
    <% end %>
  </div>

  <% if local_assigns[:action] %>
    <div class="shrink-0"><%= action %></div>
  <% end %>
</div>
