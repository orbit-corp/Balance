<div class="w-full max-w-sm">
  <div class="mb-6 flex items-center justify-center gap-2">
    <span class="flex h-8 w-8 items-center justify-center rounded-md bg-neutral-900 text-sm font-semibold text-white">S</span>
    <span class="text-lg font-semibold text-neutral-900">Stubby</span>
  </div>

  <div class="space-y-5 rounded-md border border-neutral-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-y-1">
      <h1 class="text-base font-medium text-neutral-900"><%= title %></h1>
      <p class="text-sm text-neutral-500"><%= description %></p>
    </div>

    <%= yield %>

    <div class="flex items-center justify-between gap-3 text-sm">
      <% Array(links).each do |link| %>
        <%= link_to link[:label], link[:path], class: link[:emphasis] ? "font-medium text-neutral-900 hover:underline" : "text-neutral-500 transition-colors hover:text-neutral-900" %>
      <% end %>
    </div>
  </div>
</div>
