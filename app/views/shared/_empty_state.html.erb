<div class="mt-4 flex flex-col justify-center gap-2 rounded-md border border-dashed border-neutral-200 bg-white p-10 text-center">
  <div class="mx-auto w-fit rounded-md border border-neutral-100 p-4">
    <%= inline_svg_tag(icon, class: "h-6 w-6 text-neutral-400") %>
  </div>

  <h2 class="text-base font-semibold text-neutral-900"><%= title %></h2>
  <p class="mx-auto max-w-sm text-sm text-neutral-500"><%= description %></p>

  <% if local_assigns[:action] %>
    <div class="mx-auto mt-2 w-fit"><%= action %></div>
  <% end %>
</div>
