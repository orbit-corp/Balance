<div aria-label="sidenav" class="flex h-full flex-col py-3">
  <div class="flex items-center px-6 py-2">
    <span class="text-base font-semibold text-neutral-900">Stubby</span>
  </div>

  <nav class="flex flex-1 flex-col gap-5 overflow-y-auto px-3 pt-2">
    <% navigation_sections.each do |section| %>
      <div>
        <% if section[:label] %>
          <p class="px-3 pb-1 text-xs font-medium text-neutral-500"><%= section[:label] %></p>
        <% end %>

        <ul role="list" class="flex flex-col gap-1">
          <%= render partial: "shared/sidebar/nav", collection: section[:items], as: :item %>
        </ul>
      </div>
    <% end %>
  </nav>

  <div data-controller="menu" class="relative mt-3 border-t border-neutral-200 px-3 pt-3">
    <button type="button" data-menu-target="button" data-action="menu#toggle" class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2 py-2 text-left transition-colors hover:bg-neutral-100">
      <%= render "shared/sidebar/identity" %>
      <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4 flex-none text-neutral-500" %>
    </button>

    <div data-menu-target="menu" class="hidden w-56 rounded-md border border-neutral-200 bg-white p-1 shadow-md">
      <div class="flex items-center gap-2.5 px-2 py-1.5">
        <%= render "shared/sidebar/identity" %>
      </div>

      <div class="my-1 h-px bg-neutral-200"></div>

      <%= button_to session_path, method: :delete, class: "#{menu_item_class} text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "Sign out of Stubby?" } } do %>
        <%= inline_svg_tag "icons/log-out.svg", class: "h-4 w-4 flex-none" %>
        Log out
      <% end %>
    </div>
  </div>
</div>
