<% styles = {
  "notice"  => "bg-neutral-900",
  "success" => "bg-emerald-600",
  "alert"   => "bg-amber-500",
  "error"   => "bg-red-600"
} %>

<% flash.each do |key, value| %>
  <div data-controller="toast" aria-live="assertive" class="fixed top-4 z-40 flex w-full justify-center px-4">
    <div class="pointer-events-auto w-fit rounded-md <%= styles.fetch(key, styles["notice"]) %> px-3 py-2 text-sm font-medium text-white shadow-md">
      <%= value.is_a?(Hash) ? value[:message] : value %>
    </div>
  </div>
<% end %>
