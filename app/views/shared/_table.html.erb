<div class="mt-4 overflow-x-auto rounded-md border border-neutral-200">
  <table class="min-w-full divide-y divide-neutral-200">
    <thead class="bg-neutral-50">
      <tr>
        <% Array(columns).each do |column| %>
          <th scope="col" class="px-4 py-2.5 text-left text-sm font-normal whitespace-nowrap text-neutral-500 <%= column[:class] %>"><%= column[:label] %></th>
        <% end %>
      </tr>
    </thead>

    <tbody class="divide-y divide-neutral-200 bg-white">
      <%= yield %>
    </tbody>
  </table>
</div>
