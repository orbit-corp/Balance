<%# One modal shell for every dialog in the app, rendered into the layout's "modal"
    frame. Opens and closes with a transition; pass a subtitle when the form needs a
    line of explanation. %>
<% subtitle = local_assigns[:subtitle] %>
<div data-controller="modal"
     data-action="keydown->modal#keydown click->modal#clickOutside"
     class="fixed inset-0 z-50 flex items-end justify-center overflow-y-auto sm:items-center sm:p-4"
     role="dialog"
     aria-modal="true"
     aria-label="<%= title %>"
     tabindex="-1">
  <div data-modal-target="backdrop"
       class="fixed inset-0 bg-neutral-950/40 opacity-0 transition-opacity duration-200 ease-out motion-reduce:transition-none"></div>

  <div data-modal-target="panel"
       class="relative z-10 max-h-[92vh] w-full max-w-md translate-y-4 scale-[0.98] overflow-y-auto rounded-t-2xl border border-(--color-border) bg-white opacity-0 shadow-xl transition duration-200 ease-out sm:translate-y-2 sm:rounded-xl motion-reduce:transition-none">
    <div class="flex items-start justify-between gap-3 border-b border-(--color-border) px-5 py-4">
      <div class="min-w-0">
        <h2 class="text-base font-semibold text-neutral-900"><%= title %></h2>
        <% if subtitle %>
          <p class="mt-0.5 text-sm text-(--color-muted-foreground)"><%= subtitle %></p>
        <% end %>
      </div>
      <button type="button"
              data-action="modal#close"
              aria-label="Close"
              class="-mr-1.5 -mt-1 flex-none rounded-md p-1.5 text-neutral-500 transition hover:bg-(--color-accent) hover:text-neutral-900">
        <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4" %>
      </button>
    </div>

    <div class="px-5 py-4">
      <%= yield %>
    </div>
  </div>
</div>
