<%= form_with model: customer, class: "space-y-4" do |form| %>
  <% if customer.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc pl-4">
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "w-full rounded-md border border-gray-300 px-4 py-3 text-base" %>
  </div>

  <div>
    <%= form.label :phone, "Phone (optional)", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= form.telephone_field :phone, class: "w-full rounded-md border border-gray-300 px-4 py-3 text-base" %>
  </div>

  <%= form.submit customer.persisted? ? "Save changes" : "Add customer", class: "w-full rounded-md bg-gray-900 px-4 py-3 text-base font-medium text-white" %>
<% end %>
