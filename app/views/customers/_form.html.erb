<%= form_with model: customer, url: url do |form| %>
  <%= render "shared/modal/header", title: customer.persisted? ? "Edit customer" : "New customer" %>

  <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-4">
    <%= render "shared/form_errors", record: customer %>

    <div>
      <%= form.label :name, class: field_label_class %>
      <%= form.text_field :name, required: true, autofocus: true, class: field_class %>
    </div>

    <div>
      <%= form.label :phone, "Phone (optional)", class: field_label_class %>
      <%= form.telephone_field :phone, class: field_class %>
    </div>
  </div>

  <%= render "shared/modal/footer", form: form, submit_label: customer.persisted? ? "Save changes" : "Add customer" %>
<% end %>
