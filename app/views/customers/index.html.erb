<div class="mb-4 flex items-center justify-between">
  <h1 class="text-xl font-semibold text-gray-900">Customers</h1>
  <%= link_to "+ New customer", new_customer_path, class: "text-sm font-medium text-gray-900 underline" %>
</div>

<% if @customers.empty? %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center">
    <p class="text-gray-600">No customers yet.</p>
  </div>
<% else %>
  <div class="space-y-2">
    <% @customers.each do |customer| %>
      <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white p-3">
        <div>
          <p class="font-medium text-gray-900"><%= customer.name %></p>
          <p class="text-sm text-gray-500"><%= customer.phone %></p>
        </div>
        <div class="flex gap-2 text-xs">
          <%= link_to "Edit", edit_customer_path(customer), class: "text-gray-500 underline" %>
          <%= button_to "Delete", customer_path(customer), method: :delete, class: "text-red-600 underline bg-transparent p-0", form: { data: { turbo_confirm: "Delete this customer?" } } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
