<% content_for :title, "Customers" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Customers" } ] %>
<% end %>

<% new_customer = link_to(new_customer_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New customer
<% end %>

<%= render "shared/page_header",
    title: "Customers",
    description: "The people and businesses you invoice and collect from.",
    action: new_customer %>

<% if @customers.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/users.svg",
      title: "No customers yet",
      description: "Add a customer so you can attribute payments and receivables to them.",
      action: new_customer %>
<% else %>
  <%= render layout: "shared/table", locals: { columns: [ { label: "Name" }, { label: "Phone" }, { label: "", class: "w-16" } ] } do %>
    <% @customers.each do |customer| %>
      <tr id="<%= dom_id(customer) %>" class="transition-colors hover:bg-neutral-50">
        <td class="px-4 py-3 text-sm font-medium whitespace-nowrap text-neutral-900"><%= customer.name %></td>
        <td class="<%= table_cell_class %> whitespace-nowrap"><%= customer.phone.presence || blank_cell %></td>
        <td class="px-4 py-3 text-right">
          <div data-controller="menu" class="relative inline-block text-left">
            <button type="button" data-menu-target="button" data-action="menu#toggle" class="<%= icon_button_class %>">
              <span class="sr-only">Actions for <%= customer.name %></span>
              <%= inline_svg_tag "icons/dots-vertical.svg", class: "h-4 w-4" %>
            </button>

            <div data-menu-target="menu" class="hidden w-40 rounded-md border border-neutral-200 bg-white p-1 shadow-md">
              <%= link_to "Edit", edit_customer_path(customer), class: menu_item_class, data: { turbo_frame: "modal" } %>

              <div class="my-1 h-px bg-neutral-200"></div>

              <%= button_to "Delete", customer_path(customer), method: :delete,
                    class: "#{menu_item_class} text-red-600 hover:bg-red-50",
                    form: { data: { turbo_confirm: "Delete #{customer.name}?", turbo_frame: "_top" } } %>
            </div>
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>
