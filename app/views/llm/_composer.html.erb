<div class="relative rounded-xl border border-neutral-200 bg-white p-2 shadow-sm transition-colors focus-within:border-neutral-400">
  <%= form.label field, submit_label, class: "sr-only" %>
  <%= form.text_area field, rows: 2, placeholder: "Message Stubby…", autofocus: true, value: local_assigns[:value],
        data: { chat_message_form_target: "input", action: "keydown.enter->chat-message-form#submitOnEnter keydown.up->chat-message-form#previousPrompt keydown.down->chat-message-form#nextPrompt" },
        class: "block w-full resize-none border-0 bg-transparent px-2 py-1.5 text-sm leading-relaxed text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-0" %>

  <div class="mt-1 flex items-end justify-between gap-2">
    <div class="min-w-0"><%= local_assigns[:leading] %></div>

    <%= form.button type: "submit", class: "relative flex h-9 w-9 flex-none cursor-pointer items-center justify-center rounded-full bg-neutral-900 text-white transition-colors hover:bg-neutral-800" do %>
      <span class="sr-only"><%= submit_label %></span>
      <%= inline_svg_tag "icons/arrow-up-right.svg", class: "h-4 w-4 -rotate-45" %>
    <% end %>
  </div>
</div>
