<% content_for :title, "Chats" %>
<% content_for :full_bleed, "true" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <%= render "shared/drawer", title: "All chats" do %>
      <% if @llm_chats.any? %>
        <div class="space-y-0.5">
          <% @llm_chats.each do |llm_chat| %>
            <%= link_to chat_path(llm_chat), data: { turbo_frame: "_top" }, class: "block rounded-lg px-3 py-2.5 transition hover:bg-(--color-accent)" do %>
              <div class="flex items-center justify-between gap-2">
                <span class="truncate text-sm font-medium text-neutral-900"><%= llm_chat.title.presence || "New chat" %></span>
                <span class="flex-none text-xs text-neutral-400"><%= llm_chat.created_at.strftime("%b %-d, %Y") %></span>
              </div>
              <p class="mt-0.5 truncate text-xs text-neutral-500">
                <%= llm_chat.llm_model&.label || default_model_display_name %> · <%= pluralize(llm_chat.llm_messages.count, "message") %>
              </p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="px-3 py-8 text-center text-sm text-neutral-400">No chats yet.</p>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="flex min-h-0 flex-1 flex-col bg-(--color-sidebar)">
    <div class="flex flex-none items-center justify-between gap-4 border-b border-(--color-border) bg-white px-4 py-3.5 md:px-6">
      <h1 class="truncate text-base font-semibold text-neutral-900">New chat</h1>

      <%= link_to chats_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center gap-1.5 rounded-full border border-neutral-200 px-3.5 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50" do %>
        <%= inline_svg_tag "icons/list.svg", class: "h-4 w-4" %>
        <span>All chats</span>
      <% end %>
    </div>

    <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
      <div class="w-full max-w-2xl">
        <%= render "composer", chat_models: @chat_models, selected_model: @selected_model, prompt_value: @prompt %>

        <p class="mt-2.5 text-center text-xs text-neutral-400">
          Stubby may get transactions wrong — review any proposed entry before recording it.
        </p>
      </div>
    </div>
  </div>
<% end %>
