<% content_for :title, "Chats" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <%= render "shared/drawer", title: "All chats" do %>
      <% if @llm_chats.any? %>
        <div class="space-y-0.5">
          <% @llm_chats.each do |llm_chat| %>
            <%= link_to chat_path(llm_chat), data: { turbo_frame: "_top" }, class: "block rounded-lg px-3 py-2.5 transition hover:bg-(--color-accent)" do %>
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-neutral-900">Chat #<%= llm_chat.id %></span>
                <span class="text-xs text-neutral-400"><%= llm_chat.created_at.strftime("%b %-d, %Y") %></span>
              </div>
              <p class="mt-0.5 truncate text-xs text-neutral-500">
                <%= llm_chat.llm_model&.label || default_model_display_name %> · <%= pluralize(llm_chat.llm_messages.count, "message") %>
              </p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="px-3 py-8 text-center text-sm text-neutral-400">No chats yet.</p>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="w-full">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>

    <div class="flex justify-between items-center">
      <h1 class="font-bold text-4xl">Chats</h1>
      <div class="flex items-center gap-2">
        <%= link_to "Models", models_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 text-gray-900 block font-medium" %>
        <%= link_to "New chat", new_chat_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
      </div>
    </div>

    <div id="llm_chats" class="min-w-full divide-y divide-gray-200 space-y-5">
      <% if @llm_chats.any? %>
        <% @llm_chats.each do |llm_chat| %>
          <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
            <%= render llm_chat %>
            <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
              <%= link_to "Show", chat_path(llm_chat), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
              <%= button_to "Destroy", chat_path(llm_chat), method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white inline-block font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center my-10">No llm chats found.</p>
      <% end %>
    </div>
  </div>
<% end %>
