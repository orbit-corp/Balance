<% content_for :title, @llm_chat.title.presence || "New chat" %>
<% content_for :full_bleed, "true" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [
        { label: "Chat", path: chats_path },
        { label: @llm_chat.title.presence || "New chat", id: "llm_chat_#{@llm_chat.id}_title" }
      ] %>
<% end %>

<%= content_for(:topbar_actions) do %>
  <div class="flex items-center gap-1">
    <%= render "llm/chats/usage", llm_chat: @llm_chat %>

    <%= link_to chats_path(current: @llm_chat.id), title: "All chats", data: { turbo_frame: "modal" }, class: icon_button_class do %>
      <span class="sr-only">All chats</span>
      <%= inline_svg_tag "icons/list.svg", class: "h-4 w-4" %>
    <% end %>

    <%= link_to chats_path, title: "New chat", class: "ml-1 #{primary_icon_button_class}" do %>
      <span class="sr-only">New chat</span>
      <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>
    <% end %>
  </div>
<% end %>

<%= turbo_stream_from "llm_chat_#{@llm_chat.id}" %>

<% timeline = @llm_chat.timeline %>

<div class="flex min-h-0 flex-1 flex-col bg-white">
  <div class="relative min-h-0 flex-1" data-controller="messages-thread">
    <div class="h-full overflow-y-auto" data-messages-thread-target="scroller">
      <% if timeline.none? %>
        <div id="llm_chat_<%= @llm_chat.id %>_empty" class="flex h-full flex-col items-center justify-center gap-2 text-center text-neutral-400">
          <%= inline_svg_tag "icons/message-circle.svg", class: "h-6 w-6" %>
          <p class="text-sm">Send a message to start this chat.</p>
        </div>
      <% end %>

      <div id="llm_messages" class="mx-auto flex w-full max-w-3xl flex-col gap-5 px-4 py-5 pb-8 md:px-6 md:py-7 md:pb-10">
        <% timeline.each do |item| %>
          <%= render_timeline_item(item) %>
        <% end %>
      </div>
    </div>

    <button type="button"
            aria-label="Scroll to latest message"
            aria-hidden="true"
            tabindex="-1"
            data-messages-thread-target="scrollButton"
            data-action="messages-thread#scrollToLatest"
            class="pointer-events-none absolute bottom-3 left-1/2 z-10 flex h-10 w-10 -translate-x-1/2 translate-y-2 items-center justify-center rounded-full border border-neutral-800 bg-neutral-950 text-white opacity-0 shadow-lg transition-all duration-200 hover:scale-105 hover:bg-neutral-800">
      <%= inline_svg_tag "icons/arrow-down-right.svg", class: "h-4 w-4 rotate-45" %>
    </button>
  </div>

  <div class="flex-none bg-white px-4 pt-2 pb-3 md:px-6">
    <div class="mx-auto max-w-3xl">
      <%= render "llm/messages/form", llm_chat: @llm_chat, llm_message: @llm_message %>

      <p class="mt-2 text-center text-[11px] text-neutral-400">
        Review proposed entries before recording.
      </p>
    </div>
  </div>
</div>
