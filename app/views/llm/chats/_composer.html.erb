<%= form_with url: chats_path, method: :post, scope: :llm_chat, data: { controller: "chat-message-form" }, class: "contents" do |form| %>
  <div class="rounded-2xl border border-neutral-200 bg-white px-4 pt-4 pb-3 shadow-sm">
    <div class="flex items-start gap-2">
      <%= inline_svg_tag "icons/message-circle.svg", class: "mt-1 h-4 w-4 flex-none text-neutral-400" %>
      <%= form.text_area :prompt, rows: 2, placeholder: "Message Stubby…", autofocus: true, value: prompt_value,
          data: { chat_message_form_target: "input", action: "keydown.enter->chat-message-form#submitOnEnter" },
          class: "block w-full resize-none border-0 bg-transparent px-0 text-[15px] text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-0" %>
    </div>

    <div class="mt-2 flex items-center justify-between gap-2">
      <div class="relative inline-flex">
        <%= form.select :model,
            options_for_select(chat_models.map { |model| [ model.label, model.id ] }.unshift([ default_model_display_name, nil ]), selected_model),
            {},
            class: "cursor-pointer appearance-none rounded-full border border-neutral-200 bg-white py-1.5 pl-3.5 pr-8 text-sm font-medium text-neutral-700 hover:bg-neutral-50 focus:outline-none focus:ring-1 focus:ring-neutral-300" %>
        <%= inline_svg_tag "icons/chevron-right.svg", class: "pointer-events-none absolute right-3 top-1/2 h-3 w-3 -translate-y-1/2 rotate-90 text-neutral-400" %>
      </div>

      <%= form.button type: "submit", class: "inline-flex flex-none items-center gap-1.5 rounded-full bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-800" do %>
        <span>Send</span>
        <%= inline_svg_tag "icons/arrow-up-right.svg", class: "h-4 w-4" %>
      <% end %>
    </div>
  </div>
<% end %>
