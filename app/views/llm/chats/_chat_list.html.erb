<% if llm_chats.any? %>
  <div class="flex flex-col gap-4">
    <% llm_chats.group_by { |llm_chat| chat_group_label(llm_chat.updated_at.to_date) }.each do |label, group| %>
      <div>
        <p class="px-3 pb-1 text-xs font-medium tracking-wide text-neutral-400 uppercase"><%= label %></p>

        <div class="flex flex-col gap-0.5">
          <% group.each do |llm_chat| %>
            <% current = llm_chat.id == current_chat_id %>

            <%= link_to chat_path(llm_chat), data: { turbo_frame: "_top" },
                  class: "group flex items-center gap-2 rounded-md px-3 py-2 transition-colors #{current ? 'bg-neutral-100' : 'hover:bg-neutral-100'}" do %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-neutral-900"><%= llm_chat.title.presence || "New chat" %></p>
                <p class="mt-0.5 text-xs text-neutral-500">
                  <%= pluralize llm_chat.llm_messages.count, "message" %>
                  <span class="px-0.5 text-neutral-300">·</span>
                  <%= llm_chat.updated_at.strftime("%-l:%M %p") %>
                </p>
              </div>

              <% if current %>
                <span class="flex-none rounded-full bg-neutral-900 px-2 py-0.5 text-xs font-medium text-white">Open</span>
              <% else %>
                <%= inline_svg_tag "icons/chevron-right.svg", class: "h-4 w-4 flex-none text-neutral-300 opacity-0 transition-opacity group-hover:opacity-100" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-center gap-2 px-3 py-10 text-center">
    <%= inline_svg_tag "icons/message-circle.svg", class: "h-6 w-6 text-neutral-300" %>
    <p class="text-sm text-neutral-400">No chats yet.</p>
  </div>
<% end %>
