<% assistant ||= local_assigns[:message] %>

<div id="llm_message_<%= assistant.id %>" class="w-full">
  <div id="llm_message_<%= assistant.id %>_content" class="text-sm leading-relaxed whitespace-pre-wrap text-neutral-900"><%= assistant_content(assistant.content).html_safe %></div>

  <% if assistant.content.present? %>
    <div class="mt-1.5 flex items-center gap-1">
      <button type="button" data-controller="copy" data-copy-value-value="<%= assistant.content %>" data-copy-label-value="Copy" data-action="copy#copy" class="<%= icon_button_class %> text-neutral-400">
        <span class="sr-only">Copy response</span>
        <%= inline_svg_tag "icons/copy.svg", class: "h-3.5 w-3.5" %>
      </button>
      <span class="text-xs text-neutral-400"><%= assistant.created_at&.strftime("%-l:%M %p") %></span>
    </div>
  <% end %>
</div>
