<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "llm/messages/error",
    message: tool,
    title: "Tool Result Error",
    error_message: error_message %>
<% else %>
  <div class="flex justify-start">
    <div id="llm_message_<%= tool.id %>" class="max-w-[75%] space-y-2 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 py-3">
      <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium bg-neutral-200 text-neutral-600">Tool</span>

      <pre class="whitespace-pre-wrap text-neutral-700 text-sm overflow-x-auto"><%= tool.content.presence || "(no output)" %></pre>

      <div class="text-[11px] text-neutral-400"><%= tool.created_at&.strftime("%I:%M %p") %></div>
    </div>
  </div>
<% end %>
