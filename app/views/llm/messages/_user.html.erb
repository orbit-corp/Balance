<% user ||= local_assigns[:message] %>
<div class="flex justify-end">
  <div id="llm_message_<%= user.id %>" class="max-w-[75%] space-y-1 rounded-3xl bg-neutral-100 px-4 py-2.5">
    <div id="llm_message_<%= user.id %>_content" class="whitespace-pre-wrap leading-relaxed text-neutral-900"><%= user.content %></div>
    <div class="text-right text-[11px] text-neutral-400"><%= user.created_at&.strftime("%I:%M %p") %></div>
  </div>
</div>
