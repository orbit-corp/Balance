<div class="flex justify-start">
  <div id="llm_message_<%= message.id %>" class="max-w-[75%] space-y-2 rounded-2xl border border-red-200 bg-red-50 px-4 py-3">
    <span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium bg-red-100 text-red-700"><%= title.presence || "Error" %></span>

    <pre class="whitespace-pre-wrap text-red-900 text-sm overflow-x-auto"><%= error_message %></pre>

    <div class="text-[11px] text-red-500"><%= message.created_at&.strftime("%I:%M %p") %></div>
  </div>
</div>
