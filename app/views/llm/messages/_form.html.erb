<%= form_with model: llm_message, url: chat_messages_path(llm_chat), id: "new_llm_message", data: { controller: "chat-message-form" } do |form| %>
  <%= render "shared/form_errors", record: llm_message %>
  <%= render "llm/composer", form: form, field: :content, submit_label: "Send message" %>
<% end %>
