<% details = tool_detail_items(tool_name, local_assigns[:output]) %>
<% expandable = state != :running && details.any? %>

<div id="tool_call_<%= tool_call_id %>" data-message-role="tool" data-controller="<%= "row-expand" if expandable %>" class="-my-1">
  <% if state == :running %>
    <div class="grid grid-cols-[0.875rem_minmax(0,1fr)] items-center gap-2 py-0.5 text-neutral-500">
      <span class="h-3 w-3 flex-none animate-spin rounded-full border-2 border-neutral-200 border-t-neutral-600"></span>
      <span class="text-xs"><%= tool_running_label(tool_name) %></span>
    </div>
  <% else %>
    <div class="w-fit max-w-full">
      <button type="button"
              <%= "disabled" unless expandable %>
              data-action="row-expand#toggle"
              aria-expanded="false"
              class="grid max-w-full grid-cols-[0.875rem_minmax(0,1fr)_auto] items-center gap-2 py-0.5 text-left <%= state == :failed ? "text-amber-700" : "text-neutral-500" %> <%= "cursor-pointer hover:text-neutral-800" if expandable %>">
        <%= inline_svg_tag "icons/tool.svg", class: "h-3.5 w-3.5 flex-none" %>
        <span class="truncate text-xs"><%= state == :failed ? "#{tool_name.to_s.humanize} needs attention" : tool_completed_label(tool_name) %></span>

        <% if expandable %>
          <%= inline_svg_tag "icons/chevron-right.svg", class: "h-3 w-3 flex-none transition-transform", data: { row_expand_target: "icon" } %>
        <% end %>
      </button>

      <% if expandable %>
        <div hidden data-row-expand-target="detail" class="mt-1.5 ml-1 border-l border-neutral-200 pl-5">
          <ul class="flex max-w-xl flex-col gap-1 text-xs leading-5 text-neutral-500">
            <% details.each do |detail| %>
              <li><%= detail %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
