<% expandable = state == :completed && tool_name == "list_accounts" && local_assigns[:output].present? %>

<div id="tool_call_<%= tool_call_id %>" data-controller="<%= "row-expand" if expandable %>">
  <% if state == :running %>
    <div class="flex items-center gap-2.5 rounded-md border border-neutral-200 bg-white px-3 py-2.5">
      <span class="h-3.5 w-3.5 flex-none animate-spin rounded-full border-2 border-neutral-200 border-t-neutral-500"></span>
      <span class="text-sm text-neutral-500"><%= tool_running_label(tool_name) %></span>
    </div>
  <% else %>
    <div class="rounded-md border border-neutral-200 bg-white">
      <button type="button" data-action="row-expand#toggle" class="flex w-full items-center gap-2.5 px-3 py-2.5 text-left <%= "cursor-pointer" if expandable %>">
        <span class="flex h-4 w-4 flex-none items-center justify-center rounded-full bg-green-100 text-green-600">
          <%= inline_svg_tag "icons/check.svg", class: "h-2.5 w-2.5" %>
        </span>

        <span class="flex-auto text-sm text-neutral-500"><%= tool_completed_label(tool_name) %></span>

        <% if expandable %>
          <%= inline_svg_tag "icons/chevron-right.svg", class: "h-3.5 w-3.5 flex-none text-neutral-400 transition-transform", data: { row_expand_target: "icon" } %>
        <% end %>
      </button>

      <% if expandable %>
        <% accounts = Array(local_assigns[:output].is_a?(Hash) ? (output[:existing_accounts] || output["existing_accounts"]) : local_assigns[:output]) %>
        <% if accounts.any? %>
          <div hidden data-row-expand-target="detail" class="border-t border-neutral-200 bg-neutral-50 px-3 py-2.5">
            <ul class="flex flex-col gap-0.5 text-xs text-neutral-600">
              <% accounts.each do |account| %>
                <% next unless account.is_a?(Hash) %>
                <li><%= account[:name] || account["name"] %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
