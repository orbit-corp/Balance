<%#
  Locals:
    proposal — Proposal record, proposal_type "journal_entry"
    errors   — optional array of confirmation error strings
%>
<% errors ||= local_assigns[:errors] %>
<% accounts = proposal.workspace.accounts.ordered %>

<div id="proposal_<%= proposal.id %>" class="my-2 w-full max-w-md rounded-2xl border border-neutral-200 bg-white p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="text-sm font-medium text-neutral-900"><%= proposal.description %></p>
      <p class="text-xs text-neutral-400"><%= proposal.entry_date %></p>
    </div>
    <span class="flex-none rounded-full border border-indigo-100 bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">v<%= proposal.version %></span>
  </div>

  <% if proposal.confirmed? %>
    <div class="mt-3 flex items-center gap-2 rounded-lg bg-green-50 px-3 py-2.5 text-sm text-green-700">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 flex-none"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
      <span>Recorded — ₦<%= "%.2f" % (proposal.total_debit_kobo / 100.0) %> on <%= proposal.entry_date %></span>
    </div>
    <%= link_to "View in the ledger", journal_entries_path, class: "mt-2 inline-block text-sm font-medium text-neutral-700 underline" %>

  <% elsif proposal.status == "dismissed" %>
    <div class="mt-3 rounded-lg bg-neutral-50 px-3 py-2.5 text-sm text-neutral-400">Dismissed — nothing was recorded.</div>

  <% elsif proposal.status == "superseded" %>
    <div class="mt-3 rounded-lg bg-neutral-50 px-3 py-2.5 text-sm text-neutral-400">Replaced by a newer version.</div>

  <% else %>
    <%= form_with url: chat_proposal_path(proposal.llm_chat, proposal), method: :patch, class: "contents" do |form| %>
      <% if errors.present? %>
        <div class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600">
          <%= errors.join(", ") %>
        </div>
      <% end %>

      <% if proposal.needs_attention.present? %>
        <div class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-700"><%= proposal.needs_attention %></div>
      <% end %>

      <div class="mt-3 space-y-2 rounded-lg border border-neutral-200 bg-neutral-50 p-3">
        <% proposal.lines.each_with_index do |line, index| %>
          <div class="flex items-center gap-2">
            <span class="w-14 flex-none text-xs font-medium text-neutral-500"><%= line["side"].capitalize %></span>
            <select name="proposal[lines][<%= index %>][account_id]"
                    class="<%= ["min-w-0 flex-1 rounded-md border bg-white px-2 py-1.5 text-sm", line["account_id"].blank? ? "border-amber-300 text-amber-700" : "border-neutral-200 text-neutral-900"].join(" ") %>"
                    <%= "required" if line["account_id"].blank? %>>
              <option value="" <%= "selected" if line["account_id"].blank? %> disabled><%= line["account_id"].blank? ? "Choose an account" : "" %></option>
              <% accounts.each do |account| %>
                <option value="<%= account.id %>" <%= "selected" if account.id == line["account_id"] %>><%= account.name %></option>
              <% end %>
            </select>
            <input type="hidden" name="proposal[lines][<%= index %>][side]" value="<%= line["side"] %>">
            <span class="flex-none text-sm text-neutral-400">₦</span>
            <input type="number" step="0.01" min="0"
                   name="proposal[lines][<%= index %>][amount_naira]"
                   value="<%= "%.2f" % (line["amount_kobo"].to_i / 100.0) %>"
                   class="w-24 flex-none rounded-md border border-neutral-200 px-2 py-1.5 text-right text-sm text-neutral-900">
          </div>
        <% end %>

        <div class="flex items-center justify-between border-t border-neutral-200 pt-2 text-xs">
          <span class="text-neutral-400">Debits ₦<%= "%.2f" % (proposal.total_debit_kobo / 100.0) %></span>
          <span class="<%= proposal.total_debit_kobo == proposal.total_credit_kobo ? "text-neutral-400" : "font-medium text-red-600" %>">
            Credits ₦<%= "%.2f" % (proposal.total_credit_kobo / 100.0) %>
          </span>
        </div>
      </div>

      <div class="mt-3 flex items-center justify-between gap-2">
        <input type="text" name="proposal[description]" value="<%= proposal.description %>"
               class="min-w-0 flex-1 rounded-md border border-neutral-200 px-2 py-1.5 text-sm text-neutral-900" placeholder="Description">
        <input type="date" name="proposal[entry_date]" value="<%= proposal.entry_date %>"
               class="flex-none rounded-md border border-neutral-200 px-2 py-1.5 text-sm text-neutral-900">
      </div>

      <div class="mt-3 flex items-center gap-2 border-t border-neutral-100 pt-3">
        <button type="submit" formaction="<%= confirm_chat_proposal_path(proposal.llm_chat, proposal) %>"
                <%= "disabled" unless proposal.complete? %>
                class="rounded-full bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition disabled:cursor-not-allowed disabled:opacity-40 enabled:hover:bg-neutral-800">
          Confirm
        </button>
        <button type="submit" formaction="<%= dismiss_chat_proposal_path(proposal.llm_chat, proposal) %>"
                class="rounded-full px-4 py-2 text-sm font-medium text-neutral-500 transition hover:bg-neutral-100">
          Dismiss
        </button>
        <%= form.submit "Save edits", class: "ml-auto rounded-full px-4 py-2 text-sm font-medium text-neutral-500 transition hover:bg-neutral-100 cursor-pointer" %>
      </div>
    <% end %>
  <% end %>
</div>
