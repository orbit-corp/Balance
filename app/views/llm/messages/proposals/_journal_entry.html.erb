<% errors ||= local_assigns[:errors] %>
<% accounts = proposal.workspace.accounts.ordered %>
<% balanced = proposal.total_debit_kobo == proposal.total_credit_kobo %>
<% editable = proposal.pending? %>
<% status_label = editable ? "Draft" : (proposal.confirmed? ? "Recorded" : proposal.status.titleize) %>
<% input = "w-full rounded-md border border-transparent bg-transparent px-1.5 py-1 text-[13px] text-neutral-900 transition-colors hover:border-neutral-200 focus:border-[#0f7082] focus:bg-white focus:outline-none" %>

<div id="proposal_<%= proposal.id %>" data-message-role="proposal" class="w-full max-w-lg overflow-hidden rounded-xl border border-neutral-200 bg-white shadow-sm">
  <div class="flex items-start justify-between gap-3 px-4 py-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <p class="text-[11px] font-semibold tracking-wide text-[#0f7082] uppercase"><%= proposal.data["reverses_journal_entry_id"].present? ? "Reversal proposal" : "Journal entry proposal" %></p>
        <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-neutral-500"><%= status_label %></span>
      </div>
      <h3 class="mt-0.5 truncate text-sm font-semibold text-neutral-950"><%= proposal.description %></h3>
      <p class="mt-0.5 text-xs text-neutral-500"><%= proposal.entry_date.to_date.strftime("%B %-d, %Y") %></p>
    </div>
    <p class="flex-none text-lg font-semibold tracking-tight tabular-nums text-neutral-950"><%= naira(proposal.total_debit_kobo) %></p>
  </div>

  <% unless editable %>
    <div class="border-t border-neutral-200 px-5 py-4">
      <% if proposal.confirmed? %>
        <div class="flex items-center gap-2 text-sm font-medium text-green-700">
          <%= inline_svg_tag "icons/check-circle.svg", class: "h-4 w-4 flex-none" %>
          <span>Recorded in the ledger</span>
        </div>
        <%= link_to "View journal entries", journal_entries_path, class: "mt-2 inline-block text-sm font-semibold text-neutral-900 hover:underline" %>
      <% else %>
        <p class="text-sm text-neutral-500"><%= proposal.status == "dismissed" ? "Dismissed — nothing was recorded." : "Replaced by a newer proposal." %></p>
      <% end %>
    </div>
  <% else %>
    <%= form_with url: chat_proposal_path(proposal.llm_chat, proposal), method: :patch do %>
      <% if errors.present? || proposal.needs_attention.present? %>
        <div class="border-t border-neutral-200 px-5 py-3">
          <%= render "shared/form_errors", record: Array(errors) %>
          <% if proposal.needs_attention.present? %>
            <p class="mt-2 rounded-lg bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-800"><%= proposal.needs_attention %></p>
          <% end %>
        </div>
      <% end %>

      <div class="border-y border-neutral-200">
        <div class="grid grid-cols-[3.5rem_minmax(0,1fr)_6.25rem] gap-1.5 bg-neutral-50 px-4 py-1.5 text-[10px] font-semibold tracking-wide text-neutral-400 uppercase">
          <span>Side</span><span>Account</span><span class="text-right">Amount</span>
        </div>

        <div class="divide-y divide-neutral-100">
          <% proposal.lines.each_with_index do |line, index| %>
            <% missing_account = line["account_id"].blank? %>
            <div class="grid grid-cols-[3.5rem_minmax(0,1fr)_6.25rem] items-center gap-1.5 px-4 py-1.5">
              <span class="w-fit rounded px-1.5 py-0.5 text-[11px] font-semibold <%= line["side"] == "debit" ? "bg-[#e9f5f6] text-[#0f7082]" : "bg-neutral-100 text-neutral-600" %>"><%= line["side"] == "debit" ? "Debit" : "Credit" %></span>
              <select name="proposal[lines][<%= index %>][account_id]" required class="<%= input %> <%= "border-amber-300 text-amber-800" if missing_account %>">
                <option value="" disabled <%= "selected" if missing_account %>>Choose an account</option>
                <% accounts.each do |account| %>
                  <option value="<%= account.id %>" <%= "selected" if account.id.to_s == line["account_id"].to_s %>><%= account.name %></option>
                <% end %>
              </select>
              <input type="number" step="0.01" min="0.01" name="proposal[lines][<%= index %>][amount_naira]" value="<%= format("%.2f", BigDecimal(line["amount_kobo"].to_i) / 100) %>" aria-label="<%= line["side"] %> amount" class="<%= input %> text-right tabular-nums">
              <input type="hidden" name="proposal[lines][<%= index %>][side]" value="<%= line["side"] %>">
              <input type="hidden" name="proposal[lines][<%= index %>][counterparty_name]" value="<%= line["counterparty_name"] %>">
            </div>
          <% end %>
        </div>

        <div class="grid grid-cols-2 gap-3 border-t border-neutral-200 bg-neutral-50 px-4 py-2 text-[11px]">
          <div><span class="text-neutral-500">Total debits</span><strong class="ml-2 font-semibold tabular-nums text-neutral-900"><%= naira(proposal.total_debit_kobo) %></strong></div>
          <div class="text-right"><span class="text-neutral-500">Total credits</span><strong class="ml-2 font-semibold tabular-nums text-neutral-900"><%= naira(proposal.total_credit_kobo) %></strong></div>
        </div>
      </div>

      <div class="px-4 py-2">
        <label for="proposal_<%= proposal.id %>_description" class="text-[10px] font-semibold tracking-wide text-neutral-400 uppercase">Description</label>
        <%= text_field_tag "proposal[description]", proposal.description, id: "proposal_#{proposal.id}_description", class: "#{input} mt-0.5 -ml-1.5", required: true %>
      </div>

      <%= hidden_field_tag "proposal[entry_date]", proposal.entry_date, id: nil %>
      <%= hidden_field_tag "proposal[reverses_journal_entry_id]", proposal.data["reverses_journal_entry_id"], id: nil if proposal.data["reverses_journal_entry_id"] %>

      <div class="flex items-center justify-between gap-2 border-t border-neutral-200 bg-neutral-50 px-4 py-2.5">
        <p class="flex min-w-0 items-center gap-1.5 text-xs font-medium <%= balanced ? "text-green-700" : "text-red-600" %>">
          <%= inline_svg_tag(balanced ? "icons/check-circle.svg" : "icons/minus-circle.svg", class: "h-4 w-4 flex-none") %>
          <span><%= balanced ? "Balanced" : "Off by #{naira((proposal.total_debit_kobo - proposal.total_credit_kobo).abs)}" %></span>
        </p>
        <div class="flex flex-none items-center gap-1.5">
          <button type="submit" formaction="<%= dismiss_chat_proposal_path(proposal.llm_chat, proposal) %>" class="<%= ghost_button_class(size: :sm) %>">Dismiss</button>
          <button type="submit" class="<%= ghost_button_class(size: :sm) %>">Save edits</button>
          <button type="submit" formaction="<%= confirm_chat_proposal_path(proposal.llm_chat, proposal) %>" <%= "disabled" unless proposal.complete? %> class="<%= primary_button_class(size: :sm) %> disabled:cursor-not-allowed disabled:opacity-40">Record entry</button>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
