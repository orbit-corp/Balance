<% current = summary.period(days: days) %>
<% previous = summary.previous_period(days: days) %>
<% comparison = LedgerSummary::Card.new(label: nil, current: current, previous: previous) %>
<% balance_sheet = summary.balance_sheet %>
<% metrics = [
  [ "Net profit / loss", current.profit_kobo, current.profit_kobo.negative? ? "text-red-600" : "text-neutral-950" ],
  [ "Income", current.income_kobo, "text-neutral-950" ],
  [ "Expenses", current.expense_kobo, "text-neutral-950" ],
  [ "Cash balance", summary.liquid_balance_kobo, "text-neutral-950" ]
] %>

<div class="grid grid-cols-2 border-b border-neutral-200 lg:grid-cols-4">
  <% metrics.each_with_index do |(label, value, colour), index| %>
    <div class="py-5 <%= index.odd? ? 'pl-5' : 'pr-5' %> <%= index > 0 ? 'lg:border-l lg:border-neutral-200 lg:px-5' : '' %> <%= index > 1 ? 'border-t border-neutral-200 lg:border-t-0' : '' %>">
      <p class="text-xs font-medium text-neutral-500"><%= label %></p>
      <p class="mt-1.5 text-2xl font-semibold tracking-tight tabular-nums <%= colour %>"><%= naira(value) %></p>

      <% if index.zero? %>
        <p class="mt-1 text-xs text-neutral-400">
          <% if current.profit_kobo.zero? && previous.profit_kobo.zero? %>
            No activity in either period
          <% elsif previous.profit_kobo.zero? %>
            No prior-period comparison
          <% else %>
            <%= number_to_percentage(comparison.change_pct, precision: 1, format: comparison.change_pct.negative? ? "%n%" : "+%n%") %> vs prior <%= days %> days
          <% end %>
        </p>
      <% elsif label == "Cash balance" %>
        <p class="mt-1 text-xs text-neutral-400">Available liquid accounts</p>
      <% else %>
        <p class="mt-1 text-xs text-neutral-400">Last <%= days %> days</p>
      <% end %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-3 divide-x divide-neutral-200 border-b border-neutral-200 py-3 text-sm">
  <p class="pr-4 text-neutral-500">Assets <span class="ml-1 font-medium tabular-nums text-neutral-900"><%= naira(balance_sheet.assets_kobo) %></span></p>
  <p class="px-4 text-neutral-500">Liabilities <span class="ml-1 font-medium tabular-nums text-neutral-900"><%= naira(balance_sheet.liabilities_kobo) %></span></p>
  <p class="pl-4 text-neutral-500">Equity <span class="ml-1 font-medium tabular-nums text-neutral-900"><%= naira(balance_sheet.equity_kobo) %></span></p>
</div>
