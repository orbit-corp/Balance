<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
  <% [["Today", summary.today], ["This week", summary.this_week], ["This month", summary.this_month]].each do |label, period| %>
    <div class="rounded-xl border border-(--color-border) bg-white p-6">
      <p class="text-sm text-(--color-muted-foreground)"><%= label %></p>
      <p class="mt-2 text-3xl font-semibold tabular-nums <%= period.profit_kobo.negative? ? "text-red-600" : "text-neutral-900" %>">
        <%= format_naira(period.profit_kobo) %>
      </p>
      <div class="mt-3 flex gap-4 text-sm text-(--color-muted-foreground)">
        <p>In <span class="font-medium text-neutral-700 tabular-nums"><%= format_naira(period.income_kobo) %></span></p>
        <p>Out <span class="font-medium text-neutral-700 tabular-nums"><%= format_naira(period.expense_kobo) %></span></p>
      </div>
    </div>
  <% end %>
</div>
