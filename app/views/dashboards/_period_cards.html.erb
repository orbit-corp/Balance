<% trend_icon = ->(up, css) { inline_svg_tag(up ? "icons/arrow-up-right.svg" : "icons/arrow-down-right.svg", class: css) } %>

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <% summary.cards.each do |card| %>
    <% pct = card.change_pct %>
    <div class="flex flex-col rounded-xl border border-(--color-border) bg-gradient-to-t from-neutral-50 to-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-2">
        <p class="text-sm text-(--color-muted-foreground)"><%= card.label %></p>
        <% if pct %>
          <span class="inline-flex items-center gap-1 rounded-full border border-(--color-border) bg-white px-2.5 py-0.5 text-xs font-medium text-neutral-700 tabular-nums">
            <%= trend_icon.call(card.up?, "h-3.5 w-3.5") %>
            <%= pct >= 0 ? "+" : "-" %><%= pct.abs %>%
          </span>
        <% end %>
      </div>

      <p class="mt-2 text-3xl font-semibold tracking-tight tabular-nums <%= card.profit_kobo.negative? ? "text-red-600" : "text-neutral-900" %>">
        <%= format_naira(card.profit_kobo) %>
      </p>

      <div class="mt-4 space-y-1">
        <p class="flex items-center gap-1.5 text-sm font-medium text-neutral-900">
          <%= card.up? ? "Trending up" : "Trending down" %>
          <%= trend_icon.call(card.up?, "h-4 w-4") %>
        </p>
        <p class="text-sm text-(--color-muted-foreground)">
          In <span class="font-medium text-neutral-700 tabular-nums"><%= format_naira(card.income_kobo) %></span>
          <span class="px-1">·</span>
          Out <span class="font-medium text-neutral-700 tabular-nums"><%= format_naira(card.expense_kobo) %></span>
        </p>
      </div>
    </div>
  <% end %>
</div>
