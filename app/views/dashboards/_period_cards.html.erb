<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <% summary.cards.each do |card| %>
    <div class="flex flex-col rounded-md border border-neutral-200 bg-white p-5">
      <div class="flex items-start justify-between gap-2">
        <p class="text-sm text-neutral-500"><%= card.label %></p>

        <% if card.change_pct %>
          <span class="inline-flex items-center gap-1 rounded-full border border-neutral-200 px-2 py-0.5 text-xs font-medium tabular-nums text-neutral-700">
            <%= inline_svg_tag card.up? ? "icons/arrow-up-right.svg" : "icons/arrow-down-right.svg", class: "h-3.5 w-3.5" %>
            <%= number_to_percentage card.change_pct, precision: 1, format: card.change_pct.negative? ? "%n%" : "+%n%" %>
          </span>
        <% end %>
      </div>

      <p class="mt-2 text-3xl font-semibold tracking-tight tabular-nums <%= card.profit_kobo.negative? ? "text-red-600" : "text-neutral-900" %>">
        <%= naira(card.profit_kobo) %>
      </p>

      <p class="mt-4 text-sm text-neutral-500">
        In <span class="font-medium tabular-nums text-neutral-900"><%= naira(card.income_kobo) %></span>
        <span class="px-1 text-neutral-300">·</span>
        Out <span class="font-medium tabular-nums text-neutral-900"><%= naira(card.expense_kobo) %></span>
      </p>
    </div>
  <% end %>
</div>
