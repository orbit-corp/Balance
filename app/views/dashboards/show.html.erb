<% content_for :title, "Overview" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Overview" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "Overview",
    description: "Profit, cash movement, and financial position." %>

<div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-y border-neutral-200 py-3">
  <p class="text-sm text-neutral-500">Performance through <%= Date.current.strftime("%b %-d, %Y") %></p>
  <div class="inline-flex rounded-md bg-neutral-100 p-1" aria-label="Dashboard period">
    <% [ [ "7 days", 7 ], [ "30 days", 30 ], [ "90 days", 90 ] ].each do |label, days| %>
      <%= link_to label, dashboard_path(days: days),
          class: "rounded px-3 py-1.5 text-xs font-medium transition-colors #{days == @days ? 'bg-white text-neutral-950 shadow-sm' : 'text-neutral-500 hover:text-neutral-900'}" %>
    <% end %>
  </div>
</div>

<div id="period_cards">
  <%= render "dashboards/period_cards", summary: @summary, days: @days %>
</div>

<div class="mt-6">
  <%= render "dashboards/cashflow_chart", summary: @summary, days: @days %>
</div>

<div class="mt-7">
  <div class="flex items-center justify-between">
    <h2 class="text-base font-medium text-neutral-900">Recent activity</h2>
    <%= link_to "View all", journal_entries_path, class: "text-sm font-medium text-[#0f7082] hover:underline" %>
  </div>

  <div id="recent_feed">
    <%= render "dashboards/recent_feed", summary: @summary %>
  </div>
</div>
