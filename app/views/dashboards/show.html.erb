<div class="space-y-6">
  <div id="period_cards">
    <%= render "dashboards/period_cards", summary: @summary %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <%= link_to "+ Add sale", new_transaction_path(kind: "income"), data: { turbo_frame: "transaction_form" }, class: "rounded-md bg-gray-900 px-4 py-4 text-center text-base font-medium text-white" %>
    <%= link_to "+ Add expense", new_transaction_path(kind: "expense"), data: { turbo_frame: "transaction_form" }, class: "rounded-md border border-gray-300 px-4 py-4 text-center text-base font-medium text-gray-900" %>
  </div>

  <%= turbo_frame_tag "transaction_form" %>

  <div>
    <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-gray-500">Recent activity</h2>
    <div id="recent_feed" class="space-y-2">
      <%= render "dashboards/recent_feed", summary: @summary %>
    </div>
  </div>
</div>
