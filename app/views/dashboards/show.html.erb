<% content_for :title, "Dashboard" %>

<div class="space-y-6">
  <div id="period_cards">
    <%= render "dashboards/period_cards", summary: @summary %>
  </div>

  <%= render "dashboards/cashflow_chart", summary: @summary %>

  <div>
    <h2 class="mb-3 text-base font-semibold text-neutral-900">Recent activity</h2>

    <div id="recent_feed">
      <%= render "dashboards/recent_feed", summary: @summary %>
    </div>
  </div>
</div>
