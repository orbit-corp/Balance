<section aria-labelledby="performance-heading">
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 id="performance-heading" class="text-base font-medium text-neutral-900">Profit and loss trend</h2>
      <p class="mt-0.5 text-sm text-neutral-500">Daily profit or loss for the last <%= days %> days.</p>
    </div>
    <span class="text-xs text-neutral-400">Amounts in NGN</span>
  </div>

  <div class="mt-4 h-[260px] border-b border-neutral-200 pb-4">
    <%= line_chart summary.performance_series(days: days),
        height: "240px",
        colors: [ "#171717" ],
        points: false,
        curve: false,
        legend: "bottom",
        prefix: "₦",
        thousands: ",",
        library: {
          interaction: { mode: "index", intersect: false },
          plugins: { legend: { labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, padding: 18 } } },
          scales: { x: { grid: { display: false } }, y: { grid: { color: "#eeeeee" }, border: { display: false } } }
        } %>
  </div>
</section>
