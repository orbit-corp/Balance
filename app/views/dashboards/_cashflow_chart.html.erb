<% series = summary.daily_series(days: 90).map { |day| { date: day[:date].iso8601, net_kobo: day[:net_kobo] } } %>
<% ranges = [ [ "Last 3 months", 90 ], [ "Last 30 days", 30 ], [ "Last 7 days", 7 ] ] %>
<% selected_days = 30 %>

<%= tag.div class: "rounded-md border border-neutral-200 bg-white p-5", data: { controller: "chart", chart_series_value: series.to_json } do %>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-y-1">
      <h2 class="text-base font-medium text-neutral-900">Cash flow</h2>
      <p class="text-sm text-neutral-500">Running balance over the selected period</p>
    </div>

    <div class="inline-flex shrink-0 rounded-md border border-neutral-200 p-0.5">
      <% ranges.each do |label, days| %>
        <button type="button" data-chart-target="range" data-days="<%= days %>" data-action="chart#setRange"
                class="cursor-pointer rounded-md px-3 py-1.5 text-xs font-medium transition-colors <%= days == selected_days ? "bg-neutral-100 text-neutral-900" : "text-neutral-500 hover:text-neutral-900" %>">
          <%= label %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <svg data-chart-target="svg" viewBox="0 0 720 220" class="h-[220px] w-full" role="img" aria-label="Cash flow chart"></svg>
  </div>
<% end %>
