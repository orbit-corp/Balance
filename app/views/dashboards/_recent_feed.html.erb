<% journal_entries = summary.recent_journal_entries %>

<% if journal_entries.empty? %>
  <%= render "shared/empty_state",
      icon: "icons/list.svg",
      title: "Nothing recorded yet",
      description: "Once you record an entry it shows up here, newest first.",
      action: link_to("Record your first entry", new_journal_entry_path, class: primary_button_class) %>
<% else %>
  <%= render "journal_entries/table", journal_entries: journal_entries %>
<% end %>
