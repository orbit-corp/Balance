<div class="overflow-x-auto rounded-xl border border-(--color-border) bg-white">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-(--color-border) text-left text-xs font-medium uppercase text-(--color-muted-foreground)">
        <th class="px-4 py-3">Date</th>
        <th class="px-4 py-3">Description</th>
        <th class="px-4 py-3">Debit</th>
        <th class="px-4 py-3">Credit</th>
        <th class="px-4 py-3">Amount</th>
      </tr>
    </thead>
    <% journal_entries.each do |entry| %>
      <% debit_lines = entry.journal_entry_lines.select { |line| line.debit_kobo.positive? } %>
      <% credit_lines = entry.journal_entry_lines.select { |line| line.credit_kobo.positive? } %>
      <% multi_line = entry.journal_entry_lines.size > 2 %>
      <tbody class="divide-y divide-(--color-border) border-b border-(--color-border)" <% if multi_line %>data-controller="row-expand"<% end %>>
        <tr id="<%= dom_id(entry) %>"
            class="<%= "cursor-pointer hover:bg-(--color-accent)" if multi_line %>"
            <% if multi_line %>data-action="click->row-expand#toggle"<% end %>>
          <td class="px-4 py-3 whitespace-nowrap text-neutral-900">
            <% if multi_line %>
              <span data-row-expand-target="icon" class="mr-1.5 inline-block text-(--color-muted-foreground) transition-transform">▸</span>
            <% end %>
            <%= entry.entry_date.strftime("%b %-d, %Y") %>
          </td>
          <td class="px-4 py-3 text-(--color-muted-foreground)"><%= entry.description.presence || "—" %></td>
          <td class="px-4 py-3 font-medium text-neutral-900"><%= debit_lines.map { |line| line.account.name }.join(", ") %></td>
          <td class="px-4 py-3 font-medium text-neutral-900"><%= credit_lines.map { |line| line.account.name }.join(", ") %></td>
          <td class="px-4 py-3 font-semibold tabular-nums text-neutral-900"><%= format_naira(debit_lines.sum(&:debit_kobo)) %></td>
        </tr>

        <% if multi_line %>
          <tr data-row-expand-target="detail" hidden>
            <td colspan="5" class="bg-(--color-accent) px-4 py-3">
              <table class="w-full text-sm">
                <% entry.journal_entry_lines.each do |line| %>
                  <tr>
                    <td class="w-1/3 py-1 text-neutral-700"><%= line.account.name %></td>
                    <td class="w-1/3 py-1 tabular-nums text-neutral-900"><%= format_naira(line.debit_kobo) if line.debit_kobo.positive? %></td>
                    <td class="w-1/3 py-1 tabular-nums text-neutral-900"><%= format_naira(line.credit_kobo) if line.credit_kobo.positive? %></td>
                  </tr>
                <% end %>
              </table>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
</div>
