<% field_classes = "w-full rounded-md border border-(--color-input) px-3 py-2 text-sm outline-none focus:border-neutral-400" %>
<% label_classes = "mb-1.5 block text-sm font-medium text-neutral-900" %>

<%= form_with model: journal_entry, url: journal_entries_path, class: "space-y-4", data: { controller: "journal-entry-lines" } do |form| %>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :entry_date, "Date", class: label_classes %>
      <%= form.date_field :entry_date, value: journal_entry.entry_date || Date.current, required: true, class: field_classes %>
    </div>

    <div>
      <%= form.label :description, class: label_classes %>
      <%= form.text_field :description, placeholder: "Optional", class: field_classes %>
    </div>
  </div>

  <div>
    <div class="grid grid-cols-[2fr_1fr_1fr_auto] gap-2 text-sm font-medium text-neutral-900 pb-1">
      <div>Account</div>
      <div>Debit</div>
      <div>Credit</div>
      <div></div>
    </div>

    <div data-journal-entry-lines-target="lines">
      <%= form.fields_for :journal_entry_lines do |line_form| %>
        <%= render "journal_entries/line_fields", form: line_form %>
      <% end %>
    </div>

    <template data-journal-entry-lines-target="template">
      <%= form.fields_for :journal_entry_lines, JournalEntryLine.new, child_index: "__INDEX__" do |line_form| %>
        <%= render "journal_entries/line_fields", form: line_form %>
      <% end %>
    </template>

    <button type="button" data-action="journal-entry-lines#addLine" class="mt-2 text-sm font-medium text-neutral-900 hover:underline">Add line</button>

    <div class="mt-3 flex justify-end gap-6 text-sm">
      <div>Debits: <span class="font-medium" data-journal-entry-lines-target="debitTotal">0.00</span></div>
      <div>Credits: <span class="font-medium" data-journal-entry-lines-target="creditTotal">0.00</span></div>
      <div>Difference: <span class="font-medium" data-journal-entry-lines-target="difference">0.00</span></div>
    </div>
  </div>

  <%= form.submit "Record entry", class: "w-full rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-neutral-800" %>
<% end %>
