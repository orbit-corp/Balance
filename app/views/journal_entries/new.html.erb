<% content_for :title, "New journal entry" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Journal entries", path: journal_entries_path }, { label: "New entry" } ] %>
<% end %>

<%= render "shared/page_header",
    title: "New journal entry",
    description: "Add a line for each account affected. Total debits must equal total credits." %>

<div class="mt-4 max-w-3xl rounded-md border border-neutral-200 bg-white p-5">
  <%= render "journal_entries/form", journal_entry: @journal_entry %>
</div>
