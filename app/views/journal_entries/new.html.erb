<% content_for :title, "New journal entry" %>

<div class="mx-auto max-w-4xl space-y-4">
  <div>
    <%= link_to "← Journal entries", journal_entries_path, class: "text-sm text-(--color-muted-foreground) hover:text-neutral-900" %>
    <h1 class="mt-1 text-xl font-semibold text-neutral-900">New journal entry</h1>
    <p class="text-sm text-(--color-muted-foreground)">Add a line for each account affected. Total debits must equal total credits.</p>
  </div>

  <div class="rounded-xl border border-(--color-border) bg-white p-5">
    <%= render "journal_entries/form", journal_entry: @journal_entry %>
  </div>
</div>
