<% account_options = grouped_options_for_select(
     current_workspace.accounts.ordered.group_by(&:account_type).map { |type, accounts|
       [ type.humanize, accounts.map { |account| [ account.name, account.id ] } ]
     },
     form.object.account_id
   ) %>

<div data-journal-entry-lines-target="row" data-protected="<%= protected %>" class="grid grid-cols-[minmax(13rem,2fr)_minmax(8rem,1fr)_minmax(8rem,1fr)_4.5rem] items-center gap-2 border-b border-neutral-200 py-2.5">
  <%= render "shared/select_menu", form: form, attribute: :account_id,
      options: account_options, prompt: "Select account",
      select_data: { journal_entry_lines_target: "account", action: "change->journal-entry-lines#recalculate" },
      searchable: true, search_placeholder: "Search accounts…", empty_message: "No accounts found" %>
  <%= form.text_field :debit,
      value: form.object.debit&.nonzero?,
      placeholder: "0.00",
      inputmode: "decimal",
      autocomplete: "off",
      class: "#{field_class} text-right tabular-nums",
      data: { journal_entry_lines_target: "debit", action: "input->journal-entry-lines#amountChanged" } %>
  <%= form.text_field :credit,
      value: form.object.credit&.nonzero?,
      placeholder: "0.00",
      inputmode: "decimal",
      autocomplete: "off",
      class: "#{field_class} text-right tabular-nums",
      data: { journal_entry_lines_target: "credit", action: "input->journal-entry-lines#amountChanged" } %>
  <%= form.hidden_field :_destroy %>

  <% if protected %>
    <span class="text-center text-[11px] font-medium text-neutral-400">Required</span>
  <% else %>
    <button type="button" data-action="journal-entry-lines#removeLine" class="justify-self-center <%= icon_button_class %> hover:text-red-600">
      <span class="sr-only">Remove line</span>
      <%= inline_svg_tag "icons/x.svg", class: "h-4 w-4" %>
    </button>
  <% end %>
</div>
