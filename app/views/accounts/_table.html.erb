<div class="overflow-x-auto rounded-xl border border-(--color-border) bg-white">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-(--color-border) text-left text-xs font-medium uppercase text-(--color-muted-foreground)">
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Subtype</th>
        <th class="px-4 py-3">Description</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-(--color-border)">
      <% accounts.each do |account| %>
        <tr id="<%= dom_id(account) %>">
          <td class="px-4 py-3 font-medium text-neutral-900"><%= account.name %></td>
          <td class="px-4 py-3 text-(--color-muted-foreground)"><%= account.account_type.humanize %></td>
          <td class="px-4 py-3 text-(--color-muted-foreground)"><%= account.account_subtype.humanize %></td>
          <td class="px-4 py-3 text-(--color-muted-foreground)"><%= account.description.presence || "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
