<% content_for :title, "New account" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "modal" do %>
    <%= render "accounts/modal_form", account: @account %>
  <% end %>
<% else %>
  <div class="mx-auto max-w-md space-y-4">
    <div>
      <%= link_to "← Accounts", accounts_path, class: "text-sm text-(--color-muted-foreground) hover:text-neutral-900" %>
      <h1 class="mt-1 text-xl font-semibold text-neutral-900">New account</h1>
      <p class="text-sm text-(--color-muted-foreground)">Pick a type and subtype, name it, and it's ready to use.</p>
    </div>

    <div class="rounded-xl border border-(--color-border) bg-white p-5">
      <%= render "accounts/form", account: @account %>
    </div>
  </div>
<% end %>
