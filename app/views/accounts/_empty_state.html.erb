<div class="rounded-xl border border-dashed border-(--color-border) bg-white p-10 text-center">
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-(--color-accent)">
    <%= inline_svg_tag "icons/wallet.svg", class: "h-5 w-5 text-neutral-500" %>
  </div>
  <p class="mt-4 text-sm font-semibold text-neutral-900">No accounts yet</p>
  <p class="mx-auto mt-1 max-w-sm text-sm text-(--color-muted-foreground)">
    Create an account for every place money sits or moves through — a bank, cash on hand, or a category for sales.
  </p>
  <div class="mt-4 flex justify-center">
    <%= render "new_account_button" %>
  </div>
</div>
