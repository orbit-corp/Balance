<% ref_match = campaign.recent_ref_match %>
<% conversions = campaign.conversions %>
<% attributed_count = conversions.count(&:attributed?) %>

<div class="space-y-6">
  <div class="flex items-start gap-2 rounded-lg border border-neutral-200 bg-neutral-100/40 p-3 text-xs text-neutral-500">
    <span>ⓘ</span>
    <span>
      <strong class="text-neutral-700">Coming in a later release.</strong>
      This is where a sale gets tied back to the link that earned it. Preview of what it will look like below — the layout is reserved now so nothing shifts when it ships.
    </span>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="rounded-xl border border-neutral-200 bg-white p-4">
      <p class="text-sm text-neutral-500">Revenue attributed</p>
      <div class="mt-1 flex items-center justify-between">
        <p class="text-xl font-semibold tabular-nums text-neutral-300">₦ —</p>
        <span class="rounded-full border border-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-500">Soon</span>
      </div>
    </div>
    <div class="rounded-xl border border-neutral-200 bg-white p-4">
      <p class="text-sm text-neutral-500">Conversions</p>
      <div class="mt-1 flex items-center justify-between">
        <p class="text-xl font-semibold tabular-nums text-neutral-300">—</p>
        <span class="rounded-full border border-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-500">Soon</span>
      </div>
    </div>
    <div class="rounded-xl border border-neutral-200 bg-white p-4">
      <p class="text-sm text-neutral-500">Attributed rate</p>
      <div class="mt-1 flex items-center justify-between">
        <p class="text-xl font-semibold tabular-nums text-neutral-300">—</p>
        <span class="rounded-full border border-neutral-200 px-2 py-0.5 text-[11px] font-medium text-neutral-500">Soon</span>
      </div>
    </div>
  </div>

  <div class="rounded-xl border border-neutral-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-neutral-900">Record a sale</h2>
    <p class="mt-0.5 text-xs text-neutral-500">Tell Stubby which link produced a sale — or say you don't know. Every sale counts either way.</p>

    <% if ref_match %>
      <div class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 p-2.5 text-xs text-amber-800">
        <span>💬</span>
        <span>
          A forwarded WhatsApp message mentioned <strong><%= ref_match.matched_shortlink.short_url %></strong>
          (<%= ref_match.sent_at&.strftime("%b %-d, %-l:%M %p") %>). We've pre-selected it below.
        </span>
      </div>
    <% end %>

    <%= form_with url: campaign_conversions_path(campaign), method: :post, class: "mt-3 space-y-3" do %>
      <div class="space-y-1.5">
        <% campaign.campaign_channels.each do |channel| %>
          <% channel.shortlinks.each do |sl| %>
            <label class="flex items-center gap-2 rounded-md border border-neutral-200 px-3 py-2 text-sm has-[:checked]:border-neutral-900 has-[:checked]:bg-neutral-100">
              <input type="radio" name="shortlink_id" value="<%= sl.id %>" <%= "checked" if ref_match&.matched_shortlink_id == sl.id %> class="h-4 w-4">
              <%= campaign_channel_dot(channel.platform, size: "h-2.5 w-2.5") %>
              <span class="text-neutral-900"><%= sl.label.presence || "main" %></span>
              <span class="text-neutral-500"><%= sl.short_url %></span>
            </label>
          <% end %>
        <% end %>
        <label class="flex items-center gap-2 rounded-md border border-dashed border-neutral-200 px-3 py-2 text-sm has-[:checked]:border-neutral-900 has-[:checked]:bg-neutral-100">
          <input type="radio" name="shortlink_id" value="" <%= "checked" unless ref_match %> class="h-4 w-4">
          <span class="text-neutral-500">I don't know which link</span>
        </label>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="mb-1 block text-xs font-medium text-neutral-900" for="conv_amount">Amount</label>
          <input type="text" inputmode="decimal" name="amount" id="conv_amount" required placeholder="18500"
                 class="w-full rounded-md border border-neutral-200 px-3 py-2 text-sm outline-none focus:border-neutral-400">
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-neutral-900" for="conv_kind">Type</label>
          <select name="kind" id="conv_kind" class="w-full rounded-md border border-neutral-200 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-400">
            <option value="sale" selected>Sale</option>
            <option value="lead">Lead</option>
          </select>
        </div>
      </div>

      <button type="submit" class="w-full rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-neutral-800">
        Record sale
      </button>
    <% end %>
  </div>

  <div class="rounded-xl border border-neutral-200 bg-white">
    <div class="flex items-center justify-between p-4 pb-0">
      <h2 class="text-sm font-semibold text-neutral-900">Recorded sales</h2>
      <p class="tabular-nums text-sm text-neutral-900"><%= naira(campaign.total_revenue_kobo) %></p>
    </div>

    <% if conversions.empty? %>
      <p class="p-4 text-xs text-neutral-500">No sales recorded yet.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="mt-3 w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-left text-xs text-neutral-500">
              <th class="px-4 py-2 font-medium">Sale</th>
              <th class="px-4 py-2 font-medium">Link</th>
              <th class="px-4 py-2 font-medium">Attribution</th>
              <th class="px-4 py-2 font-medium">Confidence</th>
              <th class="px-4 py-2 font-medium text-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% conversions.each do |cv| %>
              <tr class="border-b border-neutral-200 last:border-0">
                <td class="px-4 py-2.5 text-neutral-700">
                  <%= cv.occurred_at.strftime("%b %-d") %>
                  <span class="text-xs text-neutral-500">· <%= cv.kind.capitalize %></span>
                </td>
                <td class="px-4 py-2.5 text-neutral-900"><%= cv.shortlink&.short_url || "—" %></td>
                <td class="px-4 py-2.5">
                  <span class="rounded-full border px-2 py-0.5 text-[11px] font-medium <%= cv.attributed? ? "border-neutral-300 text-neutral-700" : "border-dashed border-neutral-200 text-neutral-500" %>">
                    <%= cv.attributed? ? "Attributed" : "Unattributed" %>
                  </span>
                </td>
                <td class="px-4 py-2.5">
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium <%= cv.confirmed? ? "text-green-700" : "text-amber-700" %>">
                    <span class="inline-block h-2 w-2 rounded-full <%= cv.confirmed? ? "bg-green-500" : "border border-amber-500 bg-transparent" %>"></span>
                    <%= cv.confirmed? ? "Confirmed" : "Self-reported" %>
                  </span>
                </td>
                <td class="px-4 py-2.5 text-right tabular-nums font-semibold text-neutral-900"><%= naira(cv.amount_kobo) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <p class="border-t border-neutral-200 p-4 text-xs text-neutral-500">
        <strong class="text-neutral-700">Attribution</strong> = did we tie it to a link.
        <strong class="text-neutral-700">Confidence</strong> = confirmed against a bank feed, or the seller told us.
        Green is used only for <em>Confirmed</em> — self-reported money never masquerades as verified.
        <%= pluralize(attributed_count, "sale") %> attributed of <%= conversions.size %> total.
      </p>
    <% end %>
  </div>
</div>
