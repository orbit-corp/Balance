<% content_for :title, @campaign.name %>

<div class="space-y-4">
  <div>
    <div class="flex items-center gap-1.5 text-sm text-neutral-500 mb-3">
      <%= link_to "Campaigns", campaigns_path, class: "hover:text-neutral-900" %>
      <%= inline_svg_tag "icons/chevron-right.svg", class: "size-4" %>
      <span class="text-neutral-700"><%= @campaign.name %></span>
    </div>
    <div class="mt-1 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-semibold text-neutral-900"><%= @campaign.name %></h1>
        <%= campaign_status_badge(@campaign) %>
      </div>

      <div data-controller="menu" class="relative">
        <button type="button" data-menu-target="button" data-action="menu#toggle" aria-label="Campaign actions" class="rounded-md p-1.5 text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-900">
          <%= inline_svg_tag "icons/dots-vertical.svg", class: "size-4" %>
        </button>

        <div data-menu-target="menu" class="hidden absolute right-0 z-10 w-48 rounded-lg border border-neutral-200 bg-white p-1 shadow-md">
          <span class="block cursor-not-allowed rounded-md px-2 py-2 text-left text-sm text-neutral-400">Rename campaign — soon</span>
          <span class="block cursor-not-allowed rounded-md px-2 py-2 text-left text-sm text-neutral-400">Export clicks — soon</span>
          <%= button_to campaign_path(@campaign), method: :patch, params: { status: @campaign.active? ? "archived" : "active" },
                class: "w-full rounded-md bg-transparent px-2 py-2 text-left text-sm text-neutral-700 transition hover:bg-neutral-100" do %>
            <%= @campaign.active? ? "Archive campaign" : "Restore campaign" %>
          <% end %>
        </div>
      </div>
    </div>
    <p class="mt-0.5 text-xs text-neutral-500">
      <%= pluralize(@campaign.campaign_channels.size, "channel") %> · <%= pluralize(@campaign.shortlinks.size, "link") %> · <%= number_with_delimiter(@campaign.total_clicks) %> clicks
    </p>
  </div>

  <div class="border-b border-neutral-200">
    <nav class="flex gap-1">
      <% CampaignsController::TABS.each do |tab| %>
        <%= link_to tab.capitalize, campaign_path(@campaign, tab: tab),
              class: "border-b-2 px-3 py-2 text-sm font-medium transition #{@tab == tab ? "border-neutral-900 text-neutral-900" : "border-transparent text-neutral-500 hover:text-neutral-900"}" %>
      <% end %>
    </nav>
  </div>

  <%= render "campaigns/#{@tab}", campaign: @campaign %>
</div>
