<% field_classes = "w-full rounded-md border border-(--color-input) px-3 py-2 text-sm outline-none focus:border-neutral-400" %>
<% label_classes = "mb-1.5 block text-sm font-medium text-neutral-900" %>

<% if flash[:alert] %>
  <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= flash[:alert] %></div>
<% end %>

<%# Breaks out of the modal on success so the new campaign opens as a full page. %>
<%= form_with url: campaigns_path, method: :post, class: "space-y-4", data: { turbo_frame: "_top" } do %>
  <div>
    <label class="<%= label_classes %>" for="name">Campaign name</label>
    <input type="text" name="name" id="name" required value="<%= campaign&.name %>"
           placeholder="e.g. December Sale, Eid Promo"
           class="<%= field_classes %>">
  </div>

  <div>
    <p class="<%= label_classes %>">Where are you sharing?</p>
    <div class="grid grid-cols-3 gap-2">
      <% CampaignChannel.platforms.keys.each_with_index do |platform, i| %>
        <label class="flex cursor-pointer items-center justify-center gap-1.5 rounded-md border border-(--color-border) px-2 py-2 text-xs font-medium transition has-[:checked]:border-neutral-900 has-[:checked]:bg-neutral-900 has-[:checked]:text-white">
          <input type="radio" name="platform" value="<%= platform %>" class="sr-only" <%= "checked" if i.zero? %>>
          <span class="inline-block h-2.5 w-2.5 flex-none rounded-full" style="background:<%= ApplicationHelper::CAMPAIGN_CHANNEL_COLORS.fetch(platform, "#9ca3af") %>"></span>
          <%= campaign_channel_label(platform) %>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <label class="<%= label_classes %>" for="destination_url">Destination link</label>
    <input type="text" name="destination_url" id="destination_url" required
           placeholder="https://wa.me/2348012345678"
           class="<%= field_classes %>">
    <p class="mt-1.5 text-xs text-(--color-muted-foreground)">Where the tracked link sends people — your WhatsApp chat link, product page, or bio link.</p>
  </div>

  <button type="submit" class="w-full rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-neutral-800">
    Create campaign &amp; get link
  </button>
<% end %>
