<%= link_to campaign_path(campaign), class: "block rounded-xl border border-neutral-200 bg-white p-4 transition hover:border-neutral-400" do %>
  <div class="flex items-start justify-between gap-2">
    <p class="font-semibold text-neutral-900"><%= campaign.name %></p>
    <%= campaign_status_badge(campaign) %>
  </div>

  <div class="mt-1 flex items-center gap-1">
    <% campaign.campaign_channels.each do |channel| %>
      <%= campaign_channel_dot(channel.platform, size: "h-2.5 w-2.5") %>
    <% end %>
    <span class="ml-1 text-xs text-neutral-500"><%= pluralize(campaign.campaign_channels.size, "channel") %> · <%= pluralize(campaign.shortlinks.size, "link") %></span>
  </div>

  <div class="mt-3 flex items-end justify-between gap-3">
    <div>
      <p class="text-2xl font-semibold tabular-nums text-neutral-900"><%= number_with_delimiter(campaign.total_clicks) %></p>
      <p class="text-xs text-neutral-500">clicks</p>
    </div>
    <% if campaign.total_clicks.zero? %>
      <p class="pb-1 text-xs text-neutral-500">No clicks yet — share your link</p>
    <% else %>
      <div class="h-8 w-24" data-controller="chart" data-chart-sparkline-value="true" data-chart-key-value="clicks" data-chart-cumulative-value="false" data-chart-series-value="<%= campaign.click_series.to_json %>">
        <svg data-chart-target="svg" viewBox="0 0 100 32" class="h-8 w-24" role="img" aria-label="Clicks trend"></svg>
      </div>
    <% end %>
  </div>
<% end %>
