<% content_for :title, "Campaigns" %>

<%= content_for(:breadcrumb) do %>
  <%= render "shared/breadcrumb", data: [ { label: "Campaigns" } ] %>
<% end %>

<% new_campaign = link_to(new_campaign_path, class: primary_button_class, data: { turbo_frame: "modal" }) do %>
  <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>New campaign
<% end %>

<%= render "shared/page_header",
    title: "Campaigns",
    description: "Track which links bring the sales.",
    action: new_campaign %>

<% if @campaigns.empty? && @archived_campaigns.empty? && params[:q].blank? %>
  <%= render "shared/empty_state",
      icon: "icons/megaphone.svg",
      title: "No campaigns yet",
      description: "Make one short link for each place you share — WhatsApp, IG, status — and see which one brings the sales.",
      action: new_campaign %>
<% else %>
  <div class="mt-4">
    <%= form_with url: campaigns_path, method: :get do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Search campaigns", class: "#{field_class} max-w-sm" %>
    <% end %>
  </div>

  <% if @campaigns.empty? %>
    <%= render "shared/empty_state",
        icon: "icons/megaphone.svg",
        title: "No matching campaigns",
        description: "No active campaign matches that search." %>
  <% else %>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <%= render partial: "campaign_card", collection: @campaigns, as: :campaign %>
    </div>
  <% end %>

  <% if @archived_campaigns.any? %>
    <details class="group mt-4">
      <summary class="cursor-pointer text-sm font-medium text-neutral-500 transition-colors hover:text-neutral-900">
        View archived (<%= @archived_campaigns.size %>)
      </summary>

      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <%= render partial: "campaign_card", collection: @archived_campaigns, as: :campaign %>
      </div>
    </details>
  <% end %>
<% end %>
