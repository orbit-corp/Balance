<% content_for :title, "Campaigns" %>

<div class="space-y-4">
  <div>
      <h1 class="text-xl font-semibold text-neutral-900">Campaigns</h1>
      <p class="text-sm text-(--color-muted-foreground)">Track which links bring the sales.</p>
  </div>

  <% if @campaigns.empty? && @archived_campaigns.empty? && params[:q].blank? %>
    <%= render "empty_state" %>
  <% else %>
  <div class="flex items-center justify-between gap-2">
    <%= form_with url: campaigns_path, method: :get, class: "flex-1" do |form| %>
      <%= form.text_field :q, value: params[:q], placeholder: "Search campaigns", class: "w-full rounded-md border border-(--color-input) px-2 py-1.5 text-sm outline-none focus:border-neutral-400" %>
    <% end %>

     <%= link_to new_campaign_path, data: { turbo_frame: "modal" }, class: "rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition hover:bg-neutral-800 inline-flex items-center gap-1.5" do %>
      <%= inline_svg_tag "icons/plus.svg", class: "h-4 w-4" %>
      New campaign
    <% end %>
  </div>

    <% if @campaigns.empty? %>
      <p class="text-sm text-(--color-muted-foreground)">No active campaigns match "<%= params[:q] %>".</p>
    <% else %>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @campaigns.each do |campaign| %>
          <%= render "campaign_card", campaign: campaign %>
        <% end %>
      </div>
    <% end %>

    <% if @archived_campaigns.any? %>
      <details class="group">
        <summary class="cursor-pointer text-sm font-medium text-(--color-muted-foreground) hover:text-neutral-900">
          <span class="inline-block transition group-open:rotate-90">›</span>
          View archived (<%= @archived_campaigns.size %>)
        </summary>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <% @archived_campaigns.each do |campaign| %>
            <%= render "campaign_card", campaign: campaign %>
          <% end %>
        </div>
      </details>
    <% end %>
  <% end %>
</div>
