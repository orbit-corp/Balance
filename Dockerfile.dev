# syntax=docker/dockerfile:1
# check=error=true

# Development image for balance, used by compose.yaml.
# This is NOT for production — the production image is the top-level Dockerfile,
# which strips the development gem group and bakes the code in. This one keeps
# the dev/test gems and expects the code to be bind-mounted at runtime so edits
# reload live.

# Keep in sync with .ruby-version and the production Dockerfile.
ARG RUBY_VERSION=3.4.8
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Build dependencies for native gems plus the PostgreSQL client.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libpq-dev libyaml-dev pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# BINDING makes `bin/rails server` listen on all interfaces; in development Rails
# defaults to localhost, which is unreachable from the host across the container
# boundary.
ENV RAILS_ENV="development" \
    BINDING="0.0.0.0"

# Install all gems (including the development/test groups — no BUNDLE_WITHOUT).
# foreman drives Procfile.dev via bin/dev (web server + tailwind watcher).
# Gems land in /usr/local/bundle, outside /rails, so the runtime bind mount of
# the source tree does not clobber them.
COPY Gemfile Gemfile.lock ./
RUN bundle install && gem install foreman

# No `COPY . .` — compose bind-mounts the working tree over /rails at runtime.

EXPOSE 3000
CMD ["bin/dev"]
